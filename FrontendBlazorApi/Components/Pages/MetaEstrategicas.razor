@page "/MetaEstrategicas"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer

<PageTitle>Gestión de Metas Estratégicas</PageTitle>

<h3 class="mb-3">Gestión de Metas Estratégicas</h3>

<!-- Barra de acciones -->
<div class="mb-3 d-flex gap-2">
    <button class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button class="btn btn-outline-primary" @onclick="CargarMetas">Mostrar todos</button>
    <button class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

<!-- Mensajes -->
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}
<hr />

<h4>Formulario de Meta Estratégica</h4>

<EditForm Model="MetaActual" OnValidSubmit="GuardarSegunEstado">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="d-flex flex-column gap-2 mb-3" style="max-width: 500px;">
        <div class="d-flex gap-2 align-items-center">
            <div style="width: 100px;">
                <label class="form-label mb-0">Id</label>
                <InputNumber class="form-control" @bind-Value="MetaActual.Id" />
            </div>
        </div>

        <div>
            <label class="form-label mb-0">Objetivo Estratégico</label>
            <InputSelect class="form-select" @bind-Value="MetaActual.IdObjetivo" TValue="int">
                <option value="0">-- Seleccione Objetivo --</option>
                @foreach (var o in listaObjetivos)
                {
                    <option value="@o.Id">@o.Titulo</option>
                }
            </InputSelect>
        </div>

        <div>
            <label class="form-label mb-0">Título</label>
            <InputText class="form-control" @bind-Value="MetaActual.Titulo" />
        </div>

        <div>
            <label class="form-label mb-0">Descripción</label>
            <InputTextArea class="form-control" @bind-Value="MetaActual.Descripcion" />
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <label class="fw-bold m-0 align-self-center">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarMeta" disabled="@(!existeMeta)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarMeta" disabled="@(!existeMeta)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <p><em>Cargando Metas...</em></p>
}
else if (listaMetas.Count == 0)
{
    <p>No hay metas disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Objetivo Estratégico</th>
                <th>Título</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in listaMetas)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@listaObjetivos.FirstOrDefault(o => o.Id == m.IdObjetivo)?.Titulo</td>
                    <td>@m.Titulo</td>
                    <td>@m.Descripcion</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="@(() => CargarEnFormulario(m))">Cargar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MetaEstrategica> listaMetas = new();
    private List<ObjetivoEstrategico> listaObjetivos = new();

    [SupplyParameterFromForm]
    private MetaEstrategica MetaActual { get; set; } = new();

    private bool existeMeta = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlBaseApi = "api/MetaEstrategica";
    private const string urlObjetivo = "api/ObjetivoEstrategico";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarObjetivos(), CargarMetas());
    }

    private async Task CargarObjetivos()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiObjetivoEstrategico");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<ObjetivoEstrategico>>>(urlObjetivo);
            listaObjetivos = respuesta?.Datos ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar objetivos: {ex.Message}");
        }
    }

    private async Task CargarMetas()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiMetaEstrategica");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<MetaEstrategica>>>(urlBaseApi);
            listaMetas = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaMetas.Count} registro(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar metas: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        if (MetaActual.Id <= 0)
        {
            mensaje = "Debe indicar un Id válido.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMetaEstrategica");
            var ruta = $"{urlBaseApi}/Id/{MetaActual.Id}";
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<MetaEstrategica>>>(ruta);
            var encontrada = respuesta?.Datos?.FirstOrDefault();

            if (encontrada is not null)
            {
                MetaActual = new MetaEstrategica
                {
                    Id = encontrada.Id,
                    IdObjetivo = encontrada.IdObjetivo,
                    Titulo = encontrada.Titulo,
                    Descripcion = encontrada.Descripcion
                };
                existeMeta = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Meta cargada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "No encontrada.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunEstado()
    {
        if (existeMeta)
            await ActualizarMeta();
        else
            await CrearMeta();
    }

    private async Task CrearMeta()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMetaEstrategica");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, MetaActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Meta creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarMetas();
                LimpiarFormulario();
            }
            else
            {
                mensaje = "Error al crear la meta.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarMeta()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMetaEstrategica");
            var ruta = $"{urlBaseApi}/Id/{MetaActual.Id}";
            var datos = new Dictionary<string, object?>
            {
                { "IdObjetivo", MetaActual.IdObjetivo },
                { "Titulo", MetaActual.Titulo },
                { "Descripcion", MetaActual.Descripcion }
            };
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Meta actualizada correctamente.";
                claseAviso = "alert alert-success";
                await CargarMetas();
            }
            else
            {
                mensaje = "Error al actualizar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarMeta()
    {
        LimpiarMensajes();

        if (MetaActual.Id <= 0)
        {
            mensaje = "Debe indicar el Id para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMetaEstrategica");
            var ruta = $"{urlBaseApi}/Id/{MetaActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Meta eliminada.";
                claseAviso = "alert alert-success";
                await CargarMetas();
                LimpiarFormulario();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ProbarConexion()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMetaEstrategica");
            var respuesta = await cliente.GetAsync(urlBaseApi);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(MetaEstrategica m)
    {
        MetaActual = new MetaEstrategica
        {
            Id = m.Id,
            IdObjetivo = m.IdObjetivo,
            Titulo = m.Titulo,
            Descripcion = m.Descripcion
        };
        existeMeta = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Meta cargada desde la lista.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        MetaActual = new MetaEstrategica();
        existeMeta = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}
