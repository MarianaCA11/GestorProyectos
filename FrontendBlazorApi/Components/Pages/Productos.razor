@page "/Productos"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer


<PageTitle>Productos</PageTitle>

<h3>Gestión de Productos</h3>
@* ------------- BARRA DE ACCIONES GENERALES (SIN CAMBIOS) ------------- *@
<div class="mb-3 d-flex gap-2">
    @* type="button" evita que estos botones hagan submit del formulario *@
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarProducto">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@* ------------- MENSAJES DE ESTADO (SIN CAMBIOS) ------------- *@
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    @* La clase CSS viene de la variable claseAviso que cambia según el tipo de mensaje *@
    <div class="@claseAviso" role="alert">@mensaje</div>
}
<hr/>
@* -------------------------------------------------------------------------- *@
@* ------------- FORMULARIO CRUD: Maquetación más compacta y vertical ------------- *@
@* -------------------------------------------------------------------------- *@
<h4>Formulario de Producto</h4>

<EditForm Model="ProductoActual" OnValidSubmit="GuardarSegunProducto" FormName="ProductoForm">
    <DataAnnotationsValidator /> 
    <ValidationSummary />        

    <div class="container-fluid"> 
        <div class="row g-3 mb-3"> 
            
            <div class="col-md-2"> 
                <label for="idProducto" class="form-label">Id</label>
                <InputNumber id="idProducto" class="form-control" @bind-Value="ProductoActual.Id" />
            </div>
            <div class="col-md-4"> 
                <label for="tipoProducto" class="form-label">Tipo Producto</label>
                <InputSelect id="tipoProducto" class="form-select" @bind-Value="ProductoActual.IdTipoProducto" TValue="int">
                    <option value="0">-- Seleccione Tipo Producto --</option>
                    @foreach (var t in listaTipoProducto)
                    {
                       <option value="@t.Id">@t.Nombre (ID: @t.Id)</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-3"> 
                <label for="codigoProducto" class="form-label">Codigo</label>
                <InputText id="codigoProducto" class="form-control" @bind-Value="ProductoActual.Codigo" />
            </div>
            <div class="col-md-6">
                <label for="tituloProducto" class="form-label">Titulo</label>
                <InputText id="tituloProducto" class="form-control" @bind-Value="ProductoActual.Titulo" />
            </div>

            <div class="col-12">
                <label for="descripcionProducto" class="form-label">Descripcion</label>
                <InputText id="descripcionProducto" class="form-control" @bind-Value="ProductoActual.Descripcion" />
            </div>

            <div class="col-md-3"> 
                <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                <InputDate id="fechaInicio" class="form-control" @bind-Value="ProductoActual.FechaInicio" />
            </div>
            <div class="col-md-3"> 
                <label for="fechaFinPrevista" class="form-label">Fecha Fin Prevista</label>
                <InputDate id="fechaFinPrevista" class="form-control" @bind-Value="ProductoActual.FechaFinPrevista" />
            </div>
            <div class="col-md-3">
                <label for="fechaModificacion" class="form-label">Fecha Modificación</label>
                <InputDate id="fechaModificacion" class="form-control" @bind-Value="ProductoActual.FechaModificacion" />
            </div>
            <div class="col-md-3"> 
                <label for="fechaFinalizacion" class="form-label">Fecha Finalización</label>
                <InputDate id="fechaFinalizacion" class="form-control" @bind-Value="ProductoActual.FechaFinalizacion" />
            </div>

            <div class="col-12"> 
                <label for="rutaLogo" class="form-label">Ruta Logo</label>
                <InputText id="rutaLogo" class="form-control" @bind-Value="ProductoActual.RutaLogo" />
            </div>

        </div> 

        <div class="mt-3 d-flex flex-wrap gap-2">
            <label class="fw-bold m-0 align-self-center">Acciones CRUD:</label>
            
            @* CREATE / UPDATE (Submit) *@
            <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>

            <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
            <button type="button" class="btn btn-warning" @onclick="ActualizarProducto" disabled="@(!existeProducto)">Actualizar</button>
            <button type="button" class="btn btn-danger" @onclick="EliminarProducto" disabled="@(!existeProducto)">Eliminar</button>
        </div>
    </div> @* Fin de container-fluid *@
</EditForm>

<hr />

@* ------------- LISTADO (READ/LIST): Sin cambios, ya tiene el formato tabular correcto ------------- *@

@if (cargando)
{
    <p><em>Cargando Producto...</em></p>
}
else if (listaProducto.Count == 0)
{
    <p>No hay Producto disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Id TipoProducto (Nombre)</th>
                <th>Codigo</th> 
                <th>Titulo</th> 
                <th>Descripcion</th> 
                <th>FechaInicio</th> 
                <th>FechaFinPrevista</th> 
                <th>FechaModificacion</th> 
                <th>FechaFinalizacion</th> 
                <th>RutaLogo</th> 
                <th>Acciones</th> 
            </tr>
        </thead>
        <tbody>
            @foreach (var p in listaProducto)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.IdTipoProducto (@p.TipoProductoNombre)</td>
                    <td>@p.Codigo</td>
                    <td>@p.Titulo</td>
                    <td>@p.Descripcion</td>
                    <td>@p.FechaInicio?.ToShortDateString()</td> 
                    <td>@p.FechaFinPrevista?.ToShortDateString()</td> 
                    <td>@p.FechaModificacion?.ToShortDateString()</td> 
                    <td>@p.FechaFinalizacion?.ToShortDateString()</td> 
                    <td>@p.RutaLogo</td>

                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                @onclick="@(() => CargarEnFormulario(p))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
} 
@code {
    // Se asume la existencia de los modelos Producto, TipoProducto y RespuestaApi<T> en FrontendBlazorApi.Models
    
    // =============================================================================
    // VARIABLES DE ESTADO DEL COMPONENTE
    // =============================================================================
    
    // Listas principales
    private List<Producto> listaProducto = new();
    private List<TipoProducto> listaTipoProducto = new();
    

    [SupplyParameterFromForm]
    private Producto ProductoActual { get; set; } = new();
    
    private bool existeProducto = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info"; 
    private bool cargando = false;
    
    // URL base de la API
    private const string urlBaseApi = "api/Producto";
    private const string urlTipoProducto = "api/TipoProducto";

    // =============================================================================
    // MÉTODOS DEL CICLO DE VIDA DEL COMPONENTE
    // =============================================================================
    
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarDatosIniciales(), CargarProducto());
    }

    private async Task CargarDatosIniciales()
    {
        await CargarTipoProducto();
    }

    private async Task CargarTipoProducto()
    {
        try
        {
            // ASUME que 'ApiTipoProducto' está configurado en Program.cs
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto"); 
            // ASUME la existencia del modelo RespuestaApi<T>
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<TipoProducto>>>(urlTipoProducto);
            
            listaTipoProducto = respuesta?.Datos ?? new List<TipoProducto>();
        }
        catch (Exception ex) 
        {
            Console.WriteLine($"Error al cargar Tipos de Producto: {ex.Message}");
        }
    }
    
    // =============================================================================
    // OPERACIONES CRUDL (CREATE, READ, UPDATE, DELETE, LIST)
    // =============================================================================
    
    private async Task CargarProducto()
    {
        try
        {
            cargando = true;
            // ASUME que 'ApiProducto' está configurado en Program.cs
            var cliente = fabricaHttp.CreateClient("ApiProducto"); 

            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Producto>>>(urlBaseApi);
            
            listaProducto = respuesta?.Datos ?? new List<Producto>();

            mensaje = $"Se cargaron {listaProducto.Count} Producto(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        // Aunque el método se llama BuscarPorCodigo, el código usa ProductoActual.Id para la búsqueda.
        if (ProductoActual.Id <= 0) 
        {
            mensaje = "Debe indicar un Id válido (mayor a 0) para buscar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProducto");
            var ruta = $"{urlBaseApi}/Id/{ProductoActual.Id}";
            // Asume que la API devuelve una lista con 0 o 1 producto.
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Producto>>>(ruta); 
            var encontrado = respuesta?.Datos?.FirstOrDefault();

            if (encontrado is not null)
            {
                // Carga el producto encontrado directamente para evitar un constructor con todas las propiedades
                ProductoActual = encontrado;
                
                
                existeProducto = true; 
                textoBotonGuardar = "Actualizar";
                mensaje = "Producto cargado en el formulario.";
                claseAviso = "alert alert-success";
            }
            else
            {
                existeProducto = false;
                textoBotonGuardar = "Crear";
                mensaje = "Producto no encontrado.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            existeProducto = false; 
            textoBotonGuardar = "Crear";
            mensaje = $"Error al buscar Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunProducto()
    {
        if (existeProducto)
            await ActualizarProducto();
        else
            await CrearProducto();
    }

    private async Task CrearProducto()
    {
        LimpiarMensajes();
        if (!ValidarFechas())
        {
            return; // Detiene la ejecución si hay un error
        }

        try
        {
            if (ProductoActual.IdTipoProducto <= 0)
            {
                mensaje = "Debe seleccionar un Tipo Producto.";
                claseAviso = "alert alert-warning";
                return;
            }

            var cliente = fabricaHttp.CreateClient("ApiProducto");
            
            // Para crear, el ID debe ser 0 o ignorado por la API
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, ProductoActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Producto creado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarProducto();
                
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el Producto. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al crear Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarProducto()
    {
        LimpiarMensajes();

         if (!ValidarFechas())
        {
            return; // Detiene la ejecución si hay un error
        }

        if (ProductoActual.Id <= 0)
        {
            mensaje = "Debe indicar un **Id válido** para actualizar";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProducto");
            var ruta = $"{urlBaseApi}/Id/{ProductoActual.Id}";
        
            // Se envía un diccionario para una actualización PATCH/PUT parcial (asumiendo que la API lo soporta)
            var datos = new Dictionary<string, object?>
            {
                { "IdTipoProducto", ProductoActual.IdTipoProducto },
                { "Codigo", ProductoActual.Codigo },
                { "Titulo", ProductoActual.Titulo },
                { "Descripcion", ProductoActual.Descripcion },
                { "FechaInicio", ProductoActual.FechaInicio },
                { "FechaFinPrevista", ProductoActual.FechaFinPrevista },
                { "FechaModificacion", ProductoActual.FechaModificacion },
                { "FechaFinalizacion", ProductoActual.FechaFinalizacion },
                { "RutaLogo", ProductoActual.RutaLogo }
            };
            
            // Se usa PUT para actualizar
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Producto actualizado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarProducto();
                existeProducto = true;
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo actualizar el Producto. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al actualizar el Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarProducto()
    {
        LimpiarMensajes();

        if (ProductoActual.Id <= 0)
        {
            mensaje = "Debe indicar el Id para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProducto");
            var ruta = $"{urlBaseApi}/Id/{ProductoActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Producto eliminado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarProducto();

                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo eliminar el Producto. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al eliminar Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    // =============================================================================
    // MÉTODOS AUXILIARES Y DE UTILIDAD
    // =============================================================================
    
    private async Task ProbarConexion()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProducto");
            
            var respuesta = await cliente.GetAsync(urlBaseApi);
            
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error de conexión a la API: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(Producto p)
    {
        // Se usa el objeto 'p' directamente para cargar los datos del formulario.
        ProductoActual = p;
        
        existeProducto = true; 
        textoBotonGuardar = "Actualizar";
        mensaje = "Producto seleccionado desde el listado."; 
        claseAviso = "alert alert-info";
    }

    private bool ValidarFechas()
    {
        LimpiarMensajes();

        // 1. La Fecha Fin Prevista DEBE ser mayor a la Fecha Inicio
        if (ProductoActual.FechaFinPrevista <= ProductoActual.FechaInicio)
        {
            mensaje = "La fecha de fin prevista debe ser posterior a la fecha de inicio del procucto.";
            claseAviso = "alert alert-info";
            return false;
        }

        // 2. Si la Fecha Finalización ha sido colocada (no es null)
        if (ProductoActual.FechaFinalizacion.HasValue)
        {
            // La Fecha Finalización DEBE ser mayor a la Fecha Inicio
            if (ProductoActual.FechaFinalizacion.Value <= ProductoActual.FechaInicio)
            {
                mensaje = "La fecha de finalización debe ser posterior a la fecha de inicio del producto.";
                claseAviso = "alert alert-info";
                return false;
            }
            
            
            if (ProductoActual.FechaFinalizacion.Value < ProductoActual.FechaFinPrevista)
            {
                mensaje = "Advertencia: La finalización es anterior a la fecha prevista.";
                claseAviso = "alert alert-info";
                // return false; // Depende de si quiere solo advertir o bloquear
            }
            
        }

        return true; // La validación es exitosa
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        ProductoActual = new Producto();
        existeProducto = false; 
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}