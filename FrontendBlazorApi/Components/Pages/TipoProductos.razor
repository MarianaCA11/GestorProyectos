@page "/TipoProductos" 

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer


<PageTitle>Tipo Producto</PageTitle>

<h3>Gestión de Tipos Producto</h3>
@* ------------- BARRA DE ACCIONES GENERALES ------------- 
    Botones que no están relacionados con el formulario específico
*@
<div class="mb-3 d-flex gap-2">
    @* type="button" evita que estos botones hagan submit del formulario *@
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarTipoProducto">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@* ------------- MENSAJES DE ESTADO ------------- 
    Muestra mensajes de éxito, error o información al usuario
*@
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    @* La clase CSS viene de la variable claseAviso que cambia según el tipo de mensaje *@
    <div class="@claseAviso" role="alert">@mensaje</div>
}
@* ------------- FORMULARIO CRUD ------------- *@
<h4>Formulario de Tipos Productos</h4>

@* OnValidSubmit: Se corrigió a GuardarSegunTipoProducto *@
<EditForm Model="TipoProductoActual" OnValidSubmit="GuardarSegunTipoProducto" FormName="TipoProductoForm">
    @* Componentes de validación automática *@
    <DataAnnotationsValidator /> 
    <ValidationSummary />         

    @* Grid responsivo de Bootstrap para organizar los campos *@
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Id</label>
            <InputNumber class="form-control" @bind-Value="TipoProductoActual.Id" />
        </div>

        <div class="col-md-5">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="TipoProductoActual.Nombre" />
        </div>

        <div class="col-md-12">
            <label class="form-label">Descripcion</label>             
            <InputText class="form-control" @bind-Value="TipoProductoActual.Descripcion" />
         </div>
</div>
        
    <div class="mt-3 d-flex flex-wrap gap-2">
        @* type="submit": Este botón envía el formulario y ejecuta OnValidSubmit *@
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>

        @* type="button": Botones que NO envían el formulario *@
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        
        @* Los botones de actualizar y eliminar se deshabilitan si no existe el Tipo Producto cargado *@
        <button type="button" class="btn btn-warning" @onclick="ActualizarTipoProducto" disabled="@(!existeTipoProducto)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarTipoProducto" disabled="@(!existeTipoProducto)">Eliminar</button>
    </div>
</EditForm>

<hr />

@* ------------- LISTADO (READ/LIST) ------------- *@

@if (cargando)
{
    <p><em>Cargando Tipos Productos...</em></p>
}
else if (listaTipoProducto.Count == 0)
{
    <p>No hay Tipos Producto disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripcion</th>                
                <th>Acciones</th> 
            </tr>
        </thead>
        <tbody>
            @foreach (var t in listaTipoProducto)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Nombre</td>
                    <td>@t.Descripcion</td>
                    
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                @onclick="@(() => CargarEnFormulario(t))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
} 
@code {

    // =============================================================================

    // =============================================================================
    // VARIABLES DE ESTADO DEL COMPONENTE
    // =============================================================================
    
    // Lista que contiene todos los tipos Producto para mostrar en la tabla
    private List<TipoProducto> listaTipoProducto = new();
    
    // [SupplyParameterFromForm] es CRÍTICO para el formulario en Blazor Server
    [SupplyParameterFromForm]
    private TipoProducto TipoProductoActual { get; set; } = new();
    
    // Bandera que indica si el Tipo Producto en el formulario ya existe en la base de datos
    private bool existeTipoProducto = false;
    
    // Texto dinámico del botón principal
    private string textoBotonGuardar = "Crear";
    
    // Variables para mostrar mensajes al usuario
    private string mensaje = "";
    private string claseAviso = "alert alert-info"; 
    
    // Indicador visual de carga
    private bool cargando = false;
    
    // URL base de la API
    private const string urlBaseApi = "api/TipoProducto";

    // =============================================================================
    // MÉTODOS DEL CICLO DE VIDA DEL COMPONENTE
    // =============================================================================
    
    protected override async Task OnInitializedAsync()
    {
        await CargarTipoProducto();
    }

    // =============================================================================
    // OPERACIONES CRUDL (CREATE, READ, UPDATE, DELETE, LIST)
    // =============================================================================
    
    /// <summary>
    /// LISTAR: Obtiene todos los tipos producto de la API
    /// HTTP GET /api/TipoProducto
    /// </summary>
    private async Task CargarTipoProducto()
    {
        try
        {
            cargando = true;
            // Se asume que el IHttpClientFactory está configurado para "ApiTipoProducto"
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto");

            // GetFromJsonAsync: Hace GET y deserializa automáticamente el JSON
            // Se asume que la API responde con RespuestaApi<List<TipoProducto>>
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<TipoProducto>>>(urlBaseApi);
            
            listaTipoProducto = respuesta?.Datos ?? new List<TipoProducto>();

            mensaje = $"Se cargaron {listaTipoProducto.Count} Tipo Producto(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar Tipos Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    /// <summary>
    /// BUSCAR: Busca un Tipo Producto específico por Id
    /// HTTP GET /api/tipoProducto/Id/{id}
    /// </summary>
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        if (TipoProductoActual.Id <= 0) 
        {
            mensaje = "Debe indicar un Id válido (mayor a 0) para buscar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto");
            
            var ruta = $"{urlBaseApi}/Id/{TipoProductoActual.Id}";
            // Se asume que la API responde con RespuestaApi<List<TipoProducto>>
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<TipoProducto>>>(ruta); 

            // FirstOrDefault: Toma el primer elemento o null si no hay elementos
            var encontrado = respuesta?.Datos?.FirstOrDefault();

            if (encontrado is not null)
            {
                // ENCONTRADO: Carga los datos en el formulario
                // Se crea una nueva instancia para evitar modificar directamente el objeto 
                // en la lista si se hubiera cargado de allí. Aunque aquí viene de una búsqueda.
                TipoProductoActual = new TipoProducto
                {
                    Id = encontrado.Id,
                    Nombre = encontrado.Nombre, 
                    Descripcion = encontrado.Descripcion
                };

                existeTipoProducto = true; 
                textoBotonGuardar = "Actualizar";
                mensaje = "Tipo Producto cargado en el formulario.";
                claseAviso = "alert alert-success";
            }
            else
            {
                // NO ENCONTRADO: Resetea el estado a "crear"
                existeTipoProducto = false;
                textoBotonGuardar = "Crear";
                mensaje = "Tipo Producto no encontrado.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            // Error: Resetea a estado seguro
            existeTipoProducto = false;
            textoBotonGuardar = "Crear";
            mensaje = $"Error al buscar Tipo Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// LÓGICA INTELIGENTE: Decide si crear o actualizar según el estado
    /// Se llama desde OnValidSubmit del EditForm
    /// </summary>
    private async Task GuardarSegunTipoProducto()
    {

        if (existeTipoProducto)
            await ActualizarTipoProducto();
        else
            await CrearTipoProducto();
    }

    /// <summary>
    /// CREAR: Crea un nuevo Tipo Producto
    /// HTTP POST /api/tipoProducto
    /// </summary>
    private async Task CrearTipoProducto()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto");
            
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, TipoProductoActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Tipo Producto creado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarTipoProducto();
                
                // Limpia el formulario
                TipoProductoActual = new TipoProducto();
                existeTipoProducto = false; 
                textoBotonGuardar = "Crear";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el Tipo Producto. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al crear Tipo Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// ACTUALIZAR: Actualiza un Tipo Producto existente
    /// HTTP PUT /api/TipoProducto/Id/{Id}
    /// </summary>
    private async Task ActualizarTipoProducto()
    {
        LimpiarMensajes();

        if (TipoProductoActual.Id <= 0)
        {
            mensaje = "Debe indicar un **Id válido** para actualizar";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto");

            var ruta = $"{urlBaseApi}/id/{TipoProductoActual.Id}";

            // Se envía un diccionario con los campos a actualizar
            var datos = new Dictionary<string, object?>
            {
                { "Nombre", TipoProductoActual.Nombre},
                { "Descripcion", TipoProductoActual.Descripcion }
            };

            // NOTA: Si la API requiere el objeto completo, se usaría:
            // var respuesta = await cliente.PutAsJsonAsync(ruta, TipoProductoActual);
            // Pero el código original usa un diccionario para "patch" o actualización parcial (PUT)

            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Tipo Producto actualizado correctamente.";
                claseAviso = "alert alert-success";
                await CargarTipoProducto();
                existeTipoProducto = true; // Sigue en modo edición/actualización
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo actualizar el Tipo Producto. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al actualizar el Tipo Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// ELIMINAR: Elimina un Tipo Producto existente
    /// HTTP DELETE /api/TipoProducto/Id/{Id}
    /// </summary>
    private async Task EliminarTipoProducto()
    {
        LimpiarMensajes();

        if (TipoProductoActual.Id <= 0)
        {
            mensaje = "Debe indicar el Id para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto");
            
            var ruta = $"{urlBaseApi}/Id/{TipoProductoActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Tipo Producto eliminado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarTipoProducto();
                
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo eliminar el Tipo Producto. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al eliminar Tipo Producto: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    // =============================================================================
    // MÉTODOS AUXILIARES Y DE UTILIDAD
    // =============================================================================
    
    /// <summary>
    /// Prueba la conectividad con la API
    /// </summary>
    private async Task ProbarConexion()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiTipoProducto");
            
            var respuesta = await cliente.GetAsync(urlBaseApi);
            
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error de conexión a la API: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// Carga un Tipo Producto de la tabla en el formulario para edición
    /// </summary>
    /// <param name="t">El Tipo Producto seleccionado de la tabla</param>
    // CORRECCIÓN: Se cambió el nombre del parámetro de 'r' a 't' para coincidir con el bucle @foreach (var t in...)
    private void CargarEnFormulario(TipoProducto t)
    {
        // Crea una NUEVA instancia para evitar referencias compartidas
        TipoProductoActual = new TipoProducto
        {
            Id = t.Id,
            Nombre = t.Nombre,
            Descripcion= t.Descripcion
        };
        
        // Cambia el estado a "Tipo Producto existente"
        existeTipoProducto = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Tipo Producto seleccionado desde el listado.";
        claseAviso = "alert alert-info";
    }

    /// <summary>
    /// Limpia solo los mensajes
    /// </summary>
    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    /// <summary>
    /// Resetea completamente el formulario a estado inicial (Creación)
    /// </summary>
    private void LimpiarFormulario()
    {
        TipoProductoActual = new TipoProducto();
        existeTipoProducto = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}
