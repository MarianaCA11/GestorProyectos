@page "/EjecucionPresupuestos"
 
@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer
 
<PageTitle>Ejecución de Presupuestos</PageTitle>
 
<h3>Gestión de Ejecución de Presupuestos</h3>
 
<!-- Barra de acciones -->
<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarEjecuciones">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>
 
<!-- Mensajes -->
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}
<hr />
 
<h4>Formulario de Ejecución de Presupuesto</h4>
 
<EditForm Model="EjecucionActual" OnValidSubmit="GuardarSegunEjecucion">
    <DataAnnotationsValidator />
    <ValidationSummary />        
 
    <div class="d-flex flex-column gap-2 mb-3" style="max-width: 500px;">
        <div class="d-flex gap-2 align-items-center">
            <div style="width: 100px;">
                <label class="form-label mb-0">Id</label>
                <InputNumber class="form-control" @bind-Value="EjecucionActual.Id" />
            </div>
            <div class="flex-grow-1">
                <label class="form-label mb-0">Año</label>
                <InputNumber class="form-control" @bind-Value="EjecucionActual.Anio" />
            </div>
        </div>
 
        <div>
            <label class="form-label mb-0">Presupuesto asociado</label>
            <InputSelect class="form-select" @bind-Value="EjecucionActual.IdPresupuesto" TValue="int">
                <option value="0">-- Seleccione Presupuesto --</option>
                @foreach (var p in listaPresupuestoBase)
                {
                    <option value="@p.Id">Presupuesto #@p.Id - @p.MontoAprobado.ToString("C")</option>
                }
            </InputSelect>
        </div>
 
        <div>
            <label class="form-label mb-0">Monto Planeado</label>
            <InputNumber class="form-control" @bind-Value="EjecucionActual.MontoPlaneado" />
        </div>
 
        <div>
            <label class="form-label mb-0">Monto Ejecutado</label>
            <InputNumber class="form-control" @bind-Value="EjecucionActual.MontoEjecutado" />
        </div>
 
        <div>
            <label class="form-label mb-0">Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="EjecucionActual.Observaciones" />
        </div>
    </div>
       
    <div class="mt-3 d-flex flex-wrap gap-2">
        <label class="fw-bold m-0 align-self-center">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarEjecucion" disabled="@(!existeEjecucion)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarEjecucion" disabled="@(!existeEjecucion)">Eliminar</button>
    </div>
</EditForm>
 
<hr />
 
@if (cargando)
{
    <p><em>Cargando Ejecuciones...</em></p>
}
else if (listaEjecuciones.Count == 0)
{
    <p>No hay Ejecuciones disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Presupuesto Base</th>
                <th>Año</th>
                <th>Monto Planeado</th>
                <th>Monto Ejecutado</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in listaEjecuciones)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@listaPresupuestoBase.FirstOrDefault(x => x.Id == e.IdPresupuesto)?.MontoAprobado.ToString("C")</td>
                    <td>@e.Anio</td>
                    <td>@e.MontoPlaneado.ToString("C")</td>
                    <td>@e.MontoEjecutado.ToString("C")</td>
                    <td>@e.Observaciones</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => CargarEnFormulario(e))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
 
@code {
    private List<EjecucionPresupuesto> listaEjecuciones = new();
    private List<Presupuesto> listaPresupuestoBase = new();
 
    private EjecucionPresupuesto EjecucionActual { get; set; } = new();
 
    private bool existeEjecucion = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;
 
    private const string urlBaseApi = "api/EjecucionPresupuesto";
    private const string urlPresupuesto = "api/Presupuesto";
 
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarPresupuestoBase(), CargarEjecuciones());
    }
 
    private async Task CargarPresupuestoBase()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Presupuesto>>>(urlPresupuesto);
            listaPresupuestoBase = respuesta?.Datos ?? new List<Presupuesto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar presupuestos base: {ex.Message}");
        }
    }
 
    private async Task CargarEjecuciones()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiEjecucionPresupuesto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<EjecucionPresupuesto>>>(urlBaseApi);
            listaEjecuciones = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaEjecuciones.Count} registro(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar Ejecuciones: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }
 
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();
        if (EjecucionActual.Id <= 0)
        {
            mensaje = "Debe indicar un Id válido.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiEjecucionPresupuesto");
            var ruta = $"{urlBaseApi}/Id/{EjecucionActual.Id}";
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<EjecucionPresupuesto>>>(ruta);
            var encontrado = respuesta?.Datos?.FirstOrDefault();
 
            if (encontrado is not null)
            {
                EjecucionActual = new EjecucionPresupuesto
                {
                    Id = encontrado.Id,
                    IdPresupuesto = encontrado.IdPresupuesto,
                    Anio = encontrado.Anio,
                    MontoPlaneado = encontrado.MontoPlaneado,
                    MontoEjecutado = encontrado.MontoEjecutado,
                    Observaciones = encontrado.Observaciones
                };
 
                existeEjecucion = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Ejecución cargada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "No encontrada.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task GuardarSegunEjecucion()
    {
        if (existeEjecucion)
            await ActualizarEjecucion();
        else
            await CrearEjecucion();
    }
 
    private async Task CrearEjecucion()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiEjecucionPresupuesto");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, EjecucionActual);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Ejecución creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarEjecuciones();
                LimpiarFormulario();
            }
            else
            {
                mensaje = "Error al crear la ejecución.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ActualizarEjecucion()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiEjecucionPresupuesto");
            var ruta = $"{urlBaseApi}/Id/{EjecucionActual.Id}";
            var datos = new Dictionary<string, object?>
            {
                { "IdPresupuesto", EjecucionActual.IdPresupuesto},
                { "Anio", EjecucionActual.Anio},
                { "MontoPlaneado", EjecucionActual.MontoPlaneado },
                { "MontoEjecutado", EjecucionActual.MontoEjecutado },
                { "Observaciones", EjecucionActual.Observaciones}
 
            };
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Ejecución actualizada correctamente.";
                claseAviso = "alert alert-success";
                await CargarEjecuciones();
            }
            else
            {
                mensaje = "Error al actualizar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task EliminarEjecucion()
    {
        LimpiarMensajes();
        if (EjecucionActual.Id <= 0)
        {
            mensaje = "Debe indicar el Id para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiEjecucionPresupuesto");
            var ruta = $"{urlBaseApi}/Id/{EjecucionActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Ejecución eliminada.";
                claseAviso = "alert alert-success";
                await CargarEjecuciones();
                LimpiarFormulario();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ProbarConexion()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiEjecucionPresupuesto");
            var respuesta = await cliente.GetAsync(urlBaseApi);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private void CargarEnFormulario(EjecucionPresupuesto e)
    {
        EjecucionActual = new EjecucionPresupuesto
        {
            Id = e.Id,
            IdPresupuesto = e.IdPresupuesto,
            Anio = e.Anio,
            MontoPlaneado = e.MontoPlaneado,
            MontoEjecutado = e.MontoEjecutado,
            Observaciones = e.Observaciones
        };
        existeEjecucion = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Ejecución seleccionada desde el listado.";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarFormulario()
    {
        EjecucionActual = new EjecucionPresupuesto();
        existeEjecucion = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}
