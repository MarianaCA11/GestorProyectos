@page "/Actividades"
 
@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer
 
<PageTitle>Gestión de Actividades</PageTitle>
 
<h3 class="mb-4 text-primary fw-bold">Gestión de Actividades</h3>
 
<!-- ====================================================== -->
<!--  BARRA DE ACCIONES -->
<!-- ====================================================== -->
<div class="mb-3 d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarActividades">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>
 
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}
 
<hr />
 
<!-- ====================================================== -->
<!-- FORMULARIO CRUD -->
<!-- ====================================================== -->
<h4>Formulario de Actividad</h4>
 
<EditForm Model="ActividadActual" OnValidSubmit="GuardarSegunExistencia">
    <DataAnnotationsValidator />
    <ValidationSummary />
 
    <div class="row g-3 mb-3" style="max-width: 850px;">
        <div class="col-md-6">
            <label class="form-label mb-0">Id</label>
            <InputNumber class="form-control" @bind-Value="ActividadActual.Id" TValue="int" />
        </div>
        <div class="col-md-6">
            <label class="form-label mb-0">Entregable</label>
            <InputSelect class="form-select" @bind-Value="ActividadActual.IdEntregable">
                <option value="0">Seleccione un entregable</option>
                @foreach (var e in listaEntregables)
                {
                    <option value="@e.Id">@e.Titulo</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label class="form-label mb-0">Título</label>
            <InputText class="form-control" @bind-Value="ActividadActual.Titulo" />
        </div>
        <div class="col-12">
            <label class="form-label mb-0">Descripción</label>
            <InputTextArea class="form-control" @bind-Value="ActividadActual.Descripcion" />
        </div>
        <div class="col-md-6">
            <label class="form-label mb-0">Fecha Inicio</label>
            <InputDate class="form-control" @bind-Value="ActividadActual.FechaInicio" />
        </div>
        <div class="col-md-6">
            <label class="form-label mb-0">Fecha Fin Prevista</label>
            <InputDate class="form-control" @bind-Value="ActividadActual.FechaFinPrevista" />
        </div>
        <div class="col-md-6">
            <label class="form-label mb-0">Prioridad</label>
            <InputNumber class="form-control" @bind-Value="ActividadActual.Prioridad" TValue="int" />
        </div>
        <div class="col-md-6">
            <label class="form-label mb-0">% Avance</label>
            <InputNumber class="form-control" @bind-Value="ActividadActual.PorcentajeAvance" TValue="int" />
        </div>
    </div>
 
    <!-- Botones CRUD -->
    <div class="mt-3 d-flex flex-wrap align-items-center gap-3">
        <label class="fw-bold m-0 text-muted">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <div class="vr"></div>
        <button type="button" class="btn btn-outline-secondary" @onclick="BuscarPorCodigo">Buscar (por Id)</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarActividad" disabled="@(!existeActividad)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarActividad" disabled="@(!existeActividad)">Eliminar</button>
    </div>
</EditForm>
 
<hr />
 
<!-- ====================================================== -->
<!-- TABLA DE REGISTROS -->
<!-- ====================================================== -->
@if (cargando)
{
    <p><em>Cargando actividades...</em></p>
}
else if (listaActividades.Count == 0)
{
    <p>No hay actividades registradas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Entregable</th>
                <th>Título</th>
                <th>Descripción</th>
                <th>Inicio</th>
                <th>Fin Prevista</th>
                <th>Prioridad</th>
                <th>% Avance</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in listaActividades)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.IdEntregable (@item.EntregableTitulo)</td>
                    <td>@item.Titulo</td>
                    <td>@item.Descripcion</td>
                    <td>@item.FechaInicio.ToShortDateString()</td>
                    <td>@item.FechaFinPrevista.ToShortDateString()</td>
                    <td>@item.Prioridad</td>
                    <td>@item.PorcentajeAvance</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                @onclick="@(() => CargarEnFormulario(item))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
 
<!-- ====================================================== -->
<!-- C# CODE SECTION -->
<!-- ====================================================== -->
@code {
    private List<Actividad> listaActividades = new();
    private List<Entregable> listaEntregables = new();
 
    private Actividad ActividadActual { get; set; } = new();
 
    private bool existeActividad = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;
 
    private const string urlBaseApi = "api/Actividad";
    private const string urlEntregableApi = "api/Entregable";
 
    // ======================================================
    // CICLO DE VIDA
    // ======================================================
    protected override async Task OnInitializedAsync()
    {
        await CargarEntregables();
        await CargarActividades();
    }
 
    // ======================================================
    // CRUD
    // ======================================================
    private async Task CargarEntregables()
    {
        try
        {  
            var cliente = fabricaHttp.CreateClient("ApiEntregable");
            var respuesta  = await cliente.GetFromJsonAsync<RespuestaApi<List<Entregable>>>(urlEntregableApi);
            listaEntregables = respuesta?.Datos ?? new List<Entregable>();
        }
        catch
        {
            mensaje = "Error al cargar los entregables.";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task CargarActividades()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiActividad");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Actividad>>>(urlBaseApi);
            listaActividades = respuesta?.Datos ?? new List<Actividad>();
            mensaje = $"Se cargaron {listaActividades.Count} actividades.";
            claseAviso = "alert alert-success";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al listar actividades: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }
 
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();
 
        if (ActividadActual.Id <= 0)
        {
            mensaje = "Debe indicar un Id válido (mayor a 0).";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiActividad");
            var ruta= $"{urlBaseApi}/Id/{ActividadActual.Id}";
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Actividad>>>(ruta);
            var encontrado = respuesta?.Datos?.FirstOrDefault();
 
            if (encontrado is not null)
            {
                ActividadActual = new Actividad
                {
                    Id = encontrado.Id,
                    IdEntregable = encontrado.IdEntregable,
                    Titulo = encontrado.Titulo,
                    Descripcion = encontrado.Descripcion,
                    FechaInicio = encontrado.FechaInicio,
                    FechaFinPrevista = encontrado.FechaFinPrevista,
                    Prioridad = encontrado.Prioridad,
                    PorcentajeAvance = encontrado.PorcentajeAvance
                };
 
                existeActividad = true;
                textoBotonGuardar = "Actualizar";
                mensaje = $"Actividad ID {ActividadActual.Id} cargada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "No se encontró la actividad.";
                claseAviso = "alert alert-warning";
            }
        }
        catch
        {
            mensaje = "Error al buscar la actividad.";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task GuardarSegunExistencia()
    {
        LimpiarMensajes();
 
        if (!Validar())
        {
            return;
        }
 
        if (existeActividad)
            await ActualizarActividad();
        else
            await CrearActividad();
    }
 
    private async Task CrearActividad()
    {
        LimpiarMensajes();
 
        if (!Validar())
        {
            return;
        }
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiActividad");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, ActividadActual);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Actividad creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarActividades();
                LimpiarFormulario();
            }
            else
            {
                mensaje = "Error al crear la actividad.";
                claseAviso = "alert alert-danger";
            }
        }
        catch
        {
            mensaje = "Error al conectar con la API.";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ActualizarActividad()
    {
        LimpiarMensajes();
 
          if (!Validar())
        {
            return;
        }
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiActividad");
            var ruta = $"{urlBaseApi}/Id/{ActividadActual.Id}";
            var datos = new Dictionary<string, object?>
            {
                { "IdEntregable", ActividadActual.IdEntregable},
                { "Titulo", ActividadActual.Titulo},
                { "Descripcion", ActividadActual.Descripcion },
                { "FechaInicio", ActividadActual.FechaInicio},
                { "FechaFinPrevista", ActividadActual.FechaFinPrevista},
                { "FechaModificacion", ActividadActual.FechaModificacion},
                { "FechaFinalizacion", ActividadActual.FechaFinalizacion},
                { "Prioridad", ActividadActual.Prioridad},
                { "PorcentajeAvance", ActividadActual.PorcentajeAvance}
            };
 
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Actividad actualizada correctamente.";
                claseAviso = "alert alert-success";
                await CargarActividades();
                existeActividad = true;
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo actualizar el Responsable. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al actualizar el Actividad: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task EliminarActividad()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiActividad");
            var respuesta = await cliente.DeleteAsync($"{urlBaseApi}/Id/{ActividadActual.Id}");
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Actividad eliminada correctamente.";
                claseAviso = "alert alert-success";
                await CargarActividades();
                LimpiarFormulario();
            }
            else
            {
                mensaje = "Error al eliminar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch
        {
            mensaje = "Error de conexión al eliminar.";
            claseAviso = "alert alert-danger";
        }
    }
 
    // ======================================================
    // AUXILIARES
    // ======================================================
    private async Task ProbarConexion()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiActividad");
            var respuesta = await cliente.GetAsync(urlBaseApi);
            mensaje = respuesta.IsSuccessStatusCode ? "Conexión con la API verificada." : "No se pudo conectar con la API.";
            claseAviso = respuesta.IsSuccessStatusCode ? "alert alert-success" : "alert alert-warning";
        }
        catch
        {
            mensaje = "Error de conexión con la API.";
            claseAviso = "alert alert-danger";
        }
    }
 
    private void CargarEnFormulario(Actividad a)
    {
        ActividadActual = new Actividad
        {
            Id = a.Id,
            IdEntregable = a.IdEntregable,
            Titulo = a.Titulo,
            Descripcion = a.Descripcion,
            FechaInicio = a.FechaInicio,
            FechaFinPrevista = a.FechaFinPrevista,
            Prioridad = a.Prioridad,
            PorcentajeAvance = a.PorcentajeAvance
        };
 
        existeActividad = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Actividad cargada en el formulario.";
        claseAviso = "alert alert-info";
    }
 
    private bool Validar()
    {
        LimpiarMensajes();
 
        if(ActividadActual.PorcentajeAvance < 0 || ActividadActual.PorcentajeAvance > 100)
        {
            mensaje = "El porcentaje de avance debe estar entre 0 y 100.";
            claseAviso = "alert alert-info";
            return false;
 
        }
 
        if (ActividadActual.FechaFinPrevista <= ActividadActual.FechaInicio)
        {
            mensaje = "La fecha de fin prevista debe ser posterior a la fecha de inicio del proyecto.";
            claseAviso = "alert alert-info";
            return false;
        }
 
       
        if (ActividadActual.FechaFinalizacion.HasValue)
        {
 
            if (ActividadActual.FechaFinalizacion.Value <= ActividadActual.FechaInicio)
            {
                mensaje = "La fecha de finalización debe ser posterior a la fecha de inicio del proyecto.";
                claseAviso = "alert alert-info";
                return false;
            }
           
           
            if (ActividadActual.FechaFinalizacion.Value < ActividadActual.FechaFinPrevista)
            {
                mensaje = "Advertencia: La finalización es anterior a la fecha prevista.";
                claseAviso = "alert alert-info";
 
            }
           
        }
 
        return true;
    }
 
    private void LimpiarFormulario()
    {
        ActividadActual = new Actividad();
        existeActividad = false;
        textoBotonGuardar = "Crear";
        mensaje = "";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}