@page "/Archivos"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@using Archivo = FrontendBlazorApi.Models.Archivo
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer

<PageTitle>Gestión de Archivos</PageTitle>

<h3>Gestión de Archivos</h3>

<div class="mb-3 d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarArchivo">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}
<hr/>

<h4>Formulario de Archivo</h4>

<EditForm Model="ArchivoActual" OnValidSubmit="GuardarSegunArchivo">
    <DataAnnotationsValidator /> 
    <ValidationSummary />         

    <div class="d-flex flex-column gap-2 mb-3" style="max-width: 500px;"> 
        <div>
            <label class="form-label mb-0">Id</label>
            <InputNumber class="form-control" @bind-Value="ArchivoActual.Id" />
        </div>
        <div>
            <label class="form-label mb-0">Usuario</label>
            <InputSelect class="form-select" @bind-Value="ArchivoActual.IdUsuario" TValue="int">
                <option value="0">-- Seleccione Usuario --</option>
                @foreach (var u in listaUsuario)
                {
                    <option value="@u.Id">@u.Email (ID: @u.Id)</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => ArchivoActual.IdUsuario)" />
        </div>
        <div>
            <label class="form-label mb-0">Nombre</label>
            <InputText class="form-control" @bind-Value="ArchivoActual.Nombre" />
            <ValidationMessage For="@(() => ArchivoActual.Nombre)" />
        </div>
        <div>
            <label class="form-label mb-0">Ruta</label>
            <InputText class="form-control" @bind-Value="ArchivoActual.Ruta" />
            <ValidationMessage For="@(() => ArchivoActual.Ruta)" />
        </div>
        <div>
            <label class="form-label mb-0">Tipo</label>
            <InputText class="form-control" @bind-Value="ArchivoActual.Tipo" />
            <ValidationMessage For="@(() => ArchivoActual.Tipo)" />
        </div>
        <div>
            <label class="form-label mb-0">Fecha</label>
            <InputDate TValue="DateTime?" class="form-control" @bind-Value="ArchivoActual.Fecha" />
            <ValidationMessage For="@(() => ArchivoActual.Fecha)" />
        </div>
    </div>
        
    <div class="mt-3 d-flex flex-wrap gap-2">
        <label class="fw-bold m-0 align-self-center">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarArchivo" disabled="@(!existeArchivo)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarArchivo" disabled="@(!existeArchivo)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <p><em>Cargando Archivos...</em></p>
}
else if (listaArchivo.Count == 0 && !string.IsNullOrWhiteSpace(mensaje) && !mensaje.StartsWith("Se cargaron"))
{
    <p>No hay Archivos registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Usuario (Email)</th>
                <th>Ruta</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in listaArchivo)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.IdUsuario (@a.UsuarioEmail)</td>
                    <td>@a.Ruta</td>
                    <td>@a.Nombre</td>
                    <td>@a.Tipo</td>
                    <td>@a.Fecha?.ToShortDateString()</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                @onclick="@(() => CargarEnFormulario(a))">Cargar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Archivo> listaArchivo = new();
    private List<Usuario> listaUsuario = new();

    private Archivo ArchivoActual { get; set; } = new();
    
    private bool existeArchivo = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info"; 
    private bool cargando = false;
    
    private const string urlBaseApi = "api/Archivo";
    private const string urlUsuario = "api/usuario";

    protected override async Task OnInitializedAsync()
    {
        // Cargamos los usuarios y los archivos al inicio
        await Task.WhenAll(CargarArchivo(), CargarUsuarios());
    }

    private async Task CargarUsuarios()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiUsuarios");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Usuario>>>(urlUsuario);
            // Si la respuesta es exitosa y contiene datos, los cargamos.
            listaUsuario = respuesta?.Datos ?? new();
        }
        catch (Exception ex) 
        { 
            Console.WriteLine($"Error al cargar Usuarios: {ex.Message}");
            // No establecemos mensaje en pantalla para no ocultar mensajes CRUD
        }
    }

    private async Task CargarArchivo()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiArchivo"); 
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Archivo>>>(urlBaseApi);
            listaArchivo = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaArchivo.Count} Archivo(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar Archivos: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        if (ArchivoActual.Id <= 0) 
        {
            mensaje = "Debe indicar un Id válido (mayor a 0) para buscar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo");
            var ruta = $"{urlBaseApi}/Id/{ArchivoActual.Id}";
            
            // Asumiendo que esta API devuelve un RespuestaApi<List<Archivo>> con 0 o 1 elemento.
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Archivo>>>(ruta); 
            var encontrado = respuesta?.Datos?.FirstOrDefault();

            if (encontrado is not null)
            {
                ArchivoActual = encontrado;
                
                existeArchivo = true; 
                textoBotonGuardar = "Actualizar";
                mensaje = "Archivo cargado en el formulario.";
                claseAviso = "alert alert-success";
            }
            else
            {
                existeArchivo = false;
                textoBotonGuardar = "Crear";
                mensaje = "Archivo no encontrado.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            existeArchivo = false; 
            textoBotonGuardar = "Crear";
            mensaje = $"Error al buscar Archivo: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunArchivo()
    {
        if (existeArchivo)
            await ActualizarArchivo();
        else
            await CrearArchivo();
    }

    private async Task CrearArchivo()
    {
        LimpiarMensajes();

        // Validación para InputSelect (debe ser > 0 para ser un usuario válido)
        if (ArchivoActual.IdUsuario <= 0)
        {
            mensaje = "Debe seleccionar un Usuario válido.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, ArchivoActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Archivo creado correctamente.";
                claseAviso = "alert alert-success";
                await CargarArchivo();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el Archivo. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al crear Archivo: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarArchivo()
    {
        LimpiarMensajes();

        if (ArchivoActual.Id <= 0)
        {
            mensaje = "Debe indicar un Id válido para actualizar.";
            claseAviso = "alert alert-warning";
            return;
        }
        
        // Validación para InputSelect (debe ser > 0 para ser un usuario válido)
        if (ArchivoActual.IdUsuario <= 0)
        {
            mensaje = "Debe seleccionar un Usuario válido.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo");
            var ruta = $"{urlBaseApi}/Id/{ArchivoActual.Id}";

            var datos = new Dictionary<string, object?>
            {
                {"IdUsuario",ArchivoActual.IdUsuario},
                {"Nombre",ArchivoActual.Nombre},
                {"Ruta",ArchivoActual.Ruta},
                {"Tipo",ArchivoActual.Tipo},
                {"Fecha",ArchivoActual.Fecha}
            };
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Archivo actualizado correctamente.";
                claseAviso = "alert alert-success";
                await CargarArchivo();
                existeArchivo = true;
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo actualizar el Archivo. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al actualizar Archivo: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarArchivo()
    {
        LimpiarMensajes();

        if (ArchivoActual.Id <= 0)
        {
            mensaje = "Debe indicar el Id para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo");
            var ruta = $"{urlBaseApi}/Id/{ArchivoActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Archivo eliminado correctamente.";
                claseAviso = "alert alert-success";
                await CargarArchivo();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo eliminar el Archivo. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al eliminar Archivo: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ProbarConexion()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo");
            var respuesta = await cliente.GetAsync(urlBaseApi);
            
            mensaje = respuesta.IsSuccessStatusCode
                ? "Conexión con la API verificada."
                : $"La API respondió con código {(int)respuesta.StatusCode}.";
            
            claseAviso = respuesta.IsSuccessStatusCode ? "alert alert-success" : "alert alert-warning";
        }
        catch (Exception error)
        {
            mensaje = $"Error de conexión a la API: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(Archivo a)
    {
        // Creamos una nueva instancia para evitar modificar el objeto de la lista directamente
        ArchivoActual = new Archivo
        {
            Id = a.Id,
            IdUsuario = a.IdUsuario,
            Ruta = a.Ruta,
            Nombre = a.Nombre,
            Tipo = a.Tipo,
            Fecha = a.Fecha.HasValue ? a.Fecha.Value.Date : null 
        };

        existeArchivo = true; 
        textoBotonGuardar = "Actualizar";
        mensaje = "Archivo cargado desde la tabla.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        ArchivoActual = new Archivo();
        existeArchivo = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}