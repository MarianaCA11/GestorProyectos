@page "/"

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-header text-center py-5">
    <h1 class="fw-bold">Gestor de Proyectos</h1>
    <h5 class="text-light opacity-75 mt-2">MENÚ PRINCIPAL</h5>
</div>

<div class="container my-5">
    <div class="row justify-content-center g-4">
        @foreach (var item in menuItems)
        {
            <div class="col-6 col-md-4 col-lg-3 text-center">
                <NavLink class="category-card" href="@item.Url">
                    <i class="@item.Icon icon-large"></i>
                    <p class="mt-3 category-text">@item.Nombre</p>
                </NavLink>
            </div>
        }
    </div>
</div>

@code {
    private List<(string Nombre, string Url, string Icon)> menuItems = new()
    {
        ("Tipo Responsable", "TipoResponsables", "bi bi-person-badge-fill"),
        ("Tipo Proyecto", "TipoProyectos", "bi bi-diagram-3-fill"),
        ("Estados", "Estados", "bi bi-check-circle-fill"),
        ("Tipo Producto", "TipoProductos", "bi bi-box-seam-fill"),
        ("Entregables", "Entregables", "bi bi-card-checklist"),
        ("Variables Estratégicas", "VariablesEstrategicas", "bi bi-puzzle-fill"),
        ("Responsable", "Responsables", "bi bi-people-fill"),
        ("Productos", "Productos", "bi bi-bag-fill"),
        ("Proyectos", "Proyectos", "bi bi-folder-fill"),
        ("Estado Proyectos", "Estado_Proyectos", "bi bi-bar-chart-fill"),
        ("Proyecto Productos", "Proyecto_Productos", "bi bi-diagram-2-fill"),
        ("Producto Entregables", "Producto_Entregables", "bi bi-journal-check"),
        ("Responsable Entregables", "Responsable_Entregables", "bi bi-person-check-fill"),
        ("Archivos", "Archivos", "bi bi-file-earmark-fill"),
        ("Archivo Entregables", "Archivo_Entregables", "bi bi-archive-fill"),
        ("Actividades", "Actividades", "bi bi-activity"),
        ("Presupuestos", "Presupuestos", "bi bi-cash-stack"),
        ("Distribución Presupuestos", "distribucionpresupuestos", "bi bi-columns-gap"),
        ("Ejecución Presupuesto", "EjecucionPresupuestos", "bi bi-graph-up"),
        ("Objetivo Estratégico", "ObjetivoEstrategicos", "bi bi-bullseye"),
        ("Meta Estratégica", "MetaEstrategicas", "bi bi-flag-fill"),
