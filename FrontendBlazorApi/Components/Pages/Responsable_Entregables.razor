@page "/Responsable_Entregables"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer

<PageTitle>Gestión de Responsable_Entregable</PageTitle>

<h3 class="mb-4 text-primary fw-bold">Gestión de Responsable_Entregable</h3>

<div class="mb-3 d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarResponsable_Entregable">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}

<hr />

<h4 class="text-secondary">Formulario de Asociación Responsable_Entregable</h4>

<EditForm Model="Responsable_EntregableActual" OnValidSubmit="GuardarSegunResponsable_Entregable">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="d-flex flex-column gap-3 mb-3" style="max-width: 500px;">
        <div>
            <label class="form-label mb-0">Responsable</label>
            <InputSelect class="form-select" @bind-Value="Responsable_EntregableActual.IdResponsable" TValue="int">
                <option value="0">-- Seleccione Responsable --</option>
                @foreach (var r in listaResponsable)
                {
                    <option value="@r.Id">@r.Nombre (ID: @r.Id)</option>
                }
            </InputSelect>
        </div>

        <div>
            <label class="form-label mb-0">Entregable</label>
            <InputSelect class="form-select" @bind-Value="Responsable_EntregableActual.IdEntregable" TValue="int">
                <option value="0">-- Seleccione Entregable --</option>
                @foreach (var e in listaEntregable)
                {
                    <option value="@e.Id">@e.Titulo (ID: @e.Id)</option>
                }
            </InputSelect>
        </div>

        <div>
            <label class="form-label mb-0">Fecha de Asociación</label>
            <InputDate class="form-control" @bind-Value="Responsable_EntregableActual.FechaAsociacion" />
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
        <label class="fw-bold m-0">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarResponsable_Entregable" disabled="@(!existeResponsable_Entregable)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <p><em>Cargando asociaciones...</em></p>
}
else if (listaResponsable_Entregable.Count == 0)
{
    <p>No hay asociaciones disponibles.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Responsable</th>
                <th>Entregable</th>
                <th>Fecha Asociación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in listaResponsable_Entregable)
            {
                <tr>
                    <td>@r.ResponsableNombre (ID: @r.IdResponsable)</td>
                    <td>@r.EntregableTitulo (ID: @r.IdEntregable)</td>
                    <td>@r.FechaAsociacion?.ToShortDateString()</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="(() => CargarEnFormulario(r))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // ========================= VARIABLES =========================
    private List<Responsable_Entregable> listaResponsable_Entregable = new();
    private List<Entregable> listaEntregable = new();
    private List<Responsable> listaResponsable = new();

    private Responsable_Entregable Responsable_EntregableActual { get; set; } = new();

    private bool existeResponsable_Entregable = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlBaseApi = "api/Responsable_Entregable";
    private const string urlEntregable = "api/Entregable";
    private const string urlResponsable = "api/Responsable";

    // ========================= CICLO DE VIDA =========================
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarEntregable(), CargarResponsable(), CargarResponsable_Entregable());
    }

    // ========================= CARGAS =========================
    private async Task CargarResponsable()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiResponsable");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Responsable>>>(urlResponsable);
            listaResponsable = respuesta?.Datos ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar Responsables: {ex.Message}");
        }
    }

    private async Task CargarEntregable()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiEntregable");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Entregable>>>(urlEntregable);
            listaEntregable = respuesta?.Datos ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar Entregables: {ex.Message}");
        }
    }

    private async Task CargarResponsable_Entregable()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiResponsable_Entregable");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Responsable_Entregable>>>(urlBaseApi);
            listaResponsable_Entregable = respuesta?.Datos ?? [];
            mensaje = $"Se cargaron {listaResponsable_Entregable.Count} asociaciones.";
            claseAviso = "alert alert-success";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al listar asociaciones: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    // ========================= CRUD =========================
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        if (Responsable_EntregableActual.IdEntregable <= 0 || Responsable_EntregableActual.IdResponsable <= 0)
        {
            mensaje = "Debe indicar IdEntregable e IdResponsable válidos.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiResponsable_Entregable");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Responsable_Entregable>>>(urlBaseApi);
            var encontrado = respuesta?.Datos?
                .FirstOrDefault(x => x.IdEntregable == Responsable_EntregableActual.IdEntregable &&
                                     x.IdResponsable == Responsable_EntregableActual.IdResponsable);

            if (encontrado is not null)
            {
                Responsable_EntregableActual = encontrado;
                existeResponsable_Entregable = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Asociación encontrada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "Asociación no encontrada.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunResponsable_Entregable()
    {
        if (existeResponsable_Entregable)
            await ActualizarResponsable_Entregable();
        else
            await CrearResponsable_Entregable();
    }

    private async Task CrearResponsable_Entregable()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiResponsable_Entregable");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, Responsable_EntregableActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarResponsable_Entregable();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al crear: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al crear: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarResponsable_Entregable()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiResponsable_Entregable");
            var ruta = $"{urlBaseApi}/IdResponsable/{Responsable_EntregableActual.IdResponsable}";

            var datos = new Dictionary<string, object?>
            {
                { "FechaAsociacion", Responsable_EntregableActual.FechaAsociacion }
            };

            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación actualizada correctamente.";
                claseAviso = "alert alert-success";
                await CargarResponsable_Entregable();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al actualizar: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al actualizar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarResponsable_Entregable()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiResponsable_Entregable");
            var ruta = $"{urlBaseApi}/IdResponsable/{Responsable_EntregableActual.IdResponsable}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación eliminada correctamente.";
                claseAviso = "alert alert-success";
                await CargarResponsable_Entregable();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al eliminar: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al eliminar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    // ========================= AUXILIARES =========================
    private async Task ProbarConexion()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiResponsable_Entregable");
            var respuesta = await cliente.GetAsync(urlBaseApi);

            mensaje = respuesta.IsSuccessStatusCode
                ? "Conexión con la API verificada."
                : $"La API respondió con código {(int)respuesta.StatusCode}.";

            claseAviso = "alert alert-info";
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(Responsable_Entregable r)
    {
        Responsable_EntregableActual = new Responsable_Entregable
        {
            IdResponsable = r.IdResponsable,
            IdEntregable = r.IdEntregable,
            FechaAsociacion = r.FechaAsociacion
        };

        existeResponsable_Entregable = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Asociación cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        Responsable_EntregableActual = new Responsable_Entregable();
        existeResponsable_Entregable = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}

