@page "/VariablesEstrategicas"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer


<PageTitle>Variables Estrategicas</PageTitle>

<h3>Gestión de Variables Estrategicas</h3>
@* ------------- BARRA DE ACCIONES GENERALES ------------- 
    Botones que no están relacionados con el formulario específico
*@
<div class="mb-3 d-flex gap-2">
    @* type="button" evita que estos botones hagan submit del formulario *@
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarVariableEstrategica">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@* ------------- MENSAJES DE ESTADO ------------- 
    Muestra mensajes de éxito, error o información al usuario
*@
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    @* La clase CSS viene de la variable claseAviso que cambia según el tipo de mensaje *@
    <div class="@claseAviso" role="alert">@mensaje</div>
}
@* ------------- FORMULARIO CRUD ------------- *@
<h4>Formulario de VariableEstrategica</h4>

@* OnValidSubmit: Se corrigió a GuardarSegunVariableEstrategica *@
<EditForm Model="VariableEstrategicaActual" OnValidSubmit="GuardarSegunVariableEstrategica" FormName="VariableEstrategicaForm">
    @* Componentes de validación automática *@
    <DataAnnotationsValidator /> 
    <ValidationSummary />         

    @* Grid responsivo de Bootstrap para organizar los campos *@
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Id</label>
            <InputNumber class="form-control" @bind-Value="VariableEstrategicaActual.Id" />
        </div>

        <div class="col-md-5">
            <label class="form-label">Titulo</label>
            <InputText class="form-control" @bind-Value="VariableEstrategicaActual.Titulo" />
        </div>

        <div class="col-md-12">
            <label class="form-label">Descripcion</label>             
            <InputText class="form-control" @bind-Value="VariableEstrategicaActual.Descripcion" />
         </div>
        
</div>
        
    <div class="mt-3 d-flex flex-wrap gap-2">
        @* type="submit": Este botón envía el formulario y ejecuta OnValidSubmit *@
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>

        @* type="button": Botones que NO envían el formulario *@
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        
        @* Se corrigieron los nombres de los métodos y las variables disabled *@
        <button type="button" class="btn btn-warning" @onclick="ActualizarVariableEstrategica" disabled="@(!existeVariableEstrategica)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarVariableEstrategica" disabled="@(!existeVariableEstrategica)">Eliminar</button>
    </div>
</EditForm>

<hr />

@* ------------- LISTADO (READ/LIST) ------------- *@

@if (cargando)
{
    <p><em>Cargando Variable Estrategica...</em></p>
}
@* CORRECCIÓN: Usar la lista correcta (listaVariableEstrategica) *@
else if (listaVariableEstrategica.Count == 0)
{
    <p>No hay Variable Estrategica disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titulo</th>
                <th>Descripcion</th>                
                <th>Acciones</th> 
            </tr>
        </thead>
        <tbody>
            @* CORRECCIÓN: Iterar sobre la lista correcta (listaVariableEstrategica) *@
            @foreach (var v in listaVariableEstrategica)
            {
                <tr>
                    <td>@v.Id</td>
                    <td>@v.Titulo</td>
                    <td>@v.Descripcion</td>
                    
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                @onclick="@(() => CargarEnFormulario(v))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
} 
@code {
    // =============================================================================
    // VARIABLES DE ESTADO DEL COMPONENTE
    // =============================================================================
    
    // Lista que contiene todos los Variable Estrategica para mostrar en la tabla
    // Se corrige la lista en el Razor (líneas 110 y 115) para usar esta variable.
    private List<VariableEstrategica> listaVariableEstrategica = new();
    
    // [SupplyParameterFromForm] es CRÍTICO para el formulario en Blazor Server
    [SupplyParameterFromForm]
    private VariableEstrategica VariableEstrategicaActual { get; set; } = new();
    
    // Bandera que indica si el Variable Estrategica en el formulario ya existe en la base de datos
    private bool existeVariableEstrategica = false;
    
    // Texto dinámico del botón principal
    private string textoBotonGuardar = "Crear";
    
    // Variables para mostrar mensajes al usuario
    private string mensaje = "";
    private string claseAviso = "alert alert-info"; 
    
    // Indicador visual de carga
    private bool cargando = false;
    
    // URL base de la API
    private const string urlBaseApi = "api/VariableEstrategica";

    // Se asume que este modelo de respuesta existe en FrontendBlazorApi.Models
    // private class RespuestaApi<T> { public T Datos { get; set; } public string Mensaje { get; set; } }

    // =============================================================================
    // MÉTODOS DEL CICLO DE VIDA DEL COMPONENTE
    // =============================================================================
    
    protected override async Task OnInitializedAsync()
    {
        await CargarVariableEstrategica();
    }

    // =============================================================================
    // OPERACIONES CRUDL (CREATE, READ, UPDATE, DELETE, LIST)
    // =============================================================================
    
    /// <summary>
    /// LISTAR: Obtiene todos los Variable Estrategica de la API
    /// HTTP GET /api/VariableEstrategica
    /// </summary>
    private async Task CargarVariableEstrategica()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiVariableEstrategica");

            // GetFromJsonAsync: Hace GET y deserializa automáticamente el JSON
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<VariableEstrategica>>>(urlBaseApi);
            
            listaVariableEstrategica = respuesta?.Datos ?? new List<VariableEstrategica>();

            mensaje = $"Se cargaron {listaVariableEstrategica.Count} Variables Estrategica(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar Variable Estrategica: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    /// <summary>
    /// BUSCAR: Busca un Variable Estrategica específico por Id
    /// HTTP GET /api/VariableEstrategica/Id/{id}
    /// </summary>
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        if (VariableEstrategicaActual.Id <= 0) 
        {
            mensaje = "Debe indicar un Id válido (mayor a 0) para buscar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiVariableEstrategica");
            
            var ruta = $"{urlBaseApi}/Id/{VariableEstrategicaActual.Id}";
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<VariableEstrategica>>>(ruta); 

            // FirstOrDefault: Toma el primer elemento o null si no hay elementos
            var encontrado = respuesta?.Datos?.FirstOrDefault();

            if (encontrado is not null)
            {
                // ENCONTRADO: Carga los datos en el formulario
                VariableEstrategicaActual = new VariableEstrategica
                {
                    Id = encontrado.Id,
                    Titulo = encontrado.Titulo, 
                    Descripcion = encontrado.Descripcion
                };

                existeVariableEstrategica = true; 
                textoBotonGuardar = "Actualizar";
                mensaje = "Variable Estrategica cargado en el formulario.";
                claseAviso = "alert alert-success";
            }
            else
            {
                // NO ENCONTRADO: Resetea el estado a "crear"
                existeVariableEstrategica = false;
                textoBotonGuardar = "Crear";
                mensaje = "Variable Estrategica no encontrado.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            // Error: Resetea a estado seguro
            existeVariableEstrategica = false;
            textoBotonGuardar = "Crear";
            mensaje = $"Error al buscar Variable Estrategica: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// LÓGICA INTELIGENTE: Decide si crear o actualizar según el estado
    /// </summary>
    private async Task GuardarSegunVariableEstrategica()
    {

        if (existeVariableEstrategica)
            await ActualizarVariableEstrategica();
        else
            await CrearVariableEstrategica();
    }

    /// <summary>
    /// CREAR: Crea un nuevo Variable Estrategica
    /// HTTP POST /api/VariableEstrategica
    /// </summary>
    private async Task CrearVariableEstrategica()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiVariableEstrategica");
            
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, VariableEstrategicaActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Variable Estrategica creado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarVariableEstrategica();
                
                // Limpia el formulario
                VariableEstrategicaActual = new VariableEstrategica();
                existeVariableEstrategica = false; 
                textoBotonGuardar = "Crear";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el Variable Estrategica. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al crear Variable Estrategica: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// ACTUALIZAR: Actualiza un Variable Estrategica existente
    /// HTTP PUT /api/VariableEstrategica/Id/{Id}
    /// </summary>
    private async Task ActualizarVariableEstrategica()
    {
        LimpiarMensajes();

        if (VariableEstrategicaActual.Id <= 0)
        {
            mensaje = "Debe indicar un **Id válido** para actualizar";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiVariableEstrategica");

            var ruta = $"{urlBaseApi}/id/{VariableEstrategicaActual.Id}";

            // Se envía un diccionario con los campos a actualizar
            var datos = new Dictionary<string, object?>
            {
                { "Titulo", VariableEstrategicaActual.Titulo },
                { "Descripcion", VariableEstrategicaActual.Descripcion }
            };

            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Variable Estrategica actualizado correctamente.";
                claseAviso = "alert alert-success";
                await CargarVariableEstrategica();
                existeVariableEstrategica = true;
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo actualizar el Variable Estrategica. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al actualizar el Variable Estrategica: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// ELIMINAR: Elimina un Variable Estrategica existente
    /// HTTP DELETE /api/VariableEstrategica/Id/{Id}
    /// </summary>
    private async Task EliminarVariableEstrategica()
    {
        LimpiarMensajes();

        if (VariableEstrategicaActual.Id <= 0)
        {
            mensaje = "Debe indicar el Id para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiVariableEstrategica");
            
            var ruta = $"{urlBaseApi}/Id/{VariableEstrategicaActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Variable Estrategica eliminado correctamente.";
                claseAviso = "alert alert-success";
                
                await CargarVariableEstrategica();
                
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo eliminar el Variable Estrategica. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al eliminar Variable Estrategica: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    // =============================================================================
    // MÉTODOS AUXILIARES Y DE UTILIDAD
    // =============================================================================
    
    /// <summary>
    /// Prueba la conectividad con la API
    /// </summary>
    private async Task ProbarConexion()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiVariableEstrategica");
            
            var respuesta = await cliente.GetAsync(urlBaseApi);
            
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error de conexión a la API: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    /// <summary>
    /// Carga un Variable Estrategica de la tabla en el formulario para edición
    /// </summary>
    /// <param name="v">El Variable Estrategica seleccionado de la tabla</param>
    private void CargarEnFormulario(VariableEstrategica v)
    {
        // Crea una NUEVA instancia para evitar referencias compartidas
        VariableEstrategicaActual = new VariableEstrategica
        {
            Id = v.Id,
            Titulo = v.Titulo,
            Descripcion= v.Descripcion
        };
        
        // Cambia el estado a "Variable Estrategica existente"
        existeVariableEstrategica = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Variable Estrategica seleccionado desde el listado.";
        claseAviso = "alert alert-info";
    }

    /// <summary>
    /// Limpia solo los mensajes
    /// </summary>
    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    /// <summary>
    /// Resetea completamente el formulario a estado inicial (Creación)
    /// </summary>
    private void LimpiarFormulario()
    {
        VariableEstrategicaActual = new VariableEstrategica();
        existeVariableEstrategica = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}
