@page "/presupuestos"
 
@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer
 
<PageTitle>Presupuestos</PageTitle>
 
<h3>Gestión de Presupuestos</h3>
 
<!-- BARRA DE ACCIONES -->
<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarPresupuestos">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>
 
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso">@mensaje</div>
}
 
<hr />
<h4>Formulario de Presupuestos</h4>
 
<EditForm Model="PresupuestoActual" OnValidSubmit="GuardarSegunEstado">
    <DataAnnotationsValidator />
    <ValidationSummary />
 
    <div class="d-flex flex-column gap-2 mb-3" style="max-width: 600px;">
        <div class="d-flex gap-2">
            <div style="width:120px;">
                <label class="form-label mb-0">Id</label>
                <InputNumber class="form-control" @bind-Value="PresupuestoActual.Id" />
            </div>
 
            <div class="flex-grow-1">
                <label class="form-label mb-0">Proyecto</label>
                <InputSelect class="form-select" @bind-Value="PresupuestoActual.IdProyecto" TValue="int">
                    <option value="0">-- Seleccione Proyecto --</option>
                    @foreach (var p in listaProyectos)
                    {
                        <option value="@p.Id">@p.Titulo</option>
                    }
                </InputSelect>
            </div>
        </div>
 
        <div class="d-flex gap-2">
            <div>
                <label class="form-label mb-0">Monto Solicitado</label>
                <InputNumber class="form-control" step="0.01" @bind-Value="PresupuestoActual.MontoSolicitado" />
            </div>
            <div>
                <label class="form-label mb-0">Monto Aprobado</label>
                <InputNumber class="form-control" step="0.01" @bind-Value="PresupuestoActual.MontoAprobado" />
            </div>
        </div>
 
        <div>
            <label class="form-label mb-0">Periodo (Año)</label>
            <InputNumber class="form-control" @bind-Value="PresupuestoActual.PeriodoAnio" />
        </div>
 
        <div>
            <label class="form-label mb-0">Estado</label>
            <InputSelect class="form-select" @bind-Value="PresupuestoActual.Estado">
                <option value="">-- Seleccione Estado --</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Aprobado">Aprobado</option>
                <option value="Rechazado">Rechazado</option>
            </InputSelect>
        </div>
 
        <div class="d-flex gap-2">
            <div>
                <label class="form-label mb-0">Fecha Solicitud</label>
                <InputDate class="form-control" @bind-Value="PresupuestoActual.FechaSolicitud" />
            </div>
            <div>
                <label class="form-label mb-0">Fecha Aprobación</label>
                <InputDate class="form-control" @bind-Value="PresupuestoActual.FechaAprobacion" />
            </div>
        </div>
 
        <div>
            <label class="form-label mb-0">Observaciones</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="PresupuestoActual.Observaciones" />
        </div>
    </div>
 
    <div class="mt-3 d-flex flex-wrap gap-2">
        <label class="fw-bold m-0 align-self-center">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorId">Buscar</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarPresupuesto" disabled="@(!existePresupuesto)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarPresupuesto" disabled="@(!existePresupuesto)">Eliminar</button>
    </div>
</EditForm>
 
<hr />
 
@if (cargando)
{
    <p><em>Cargando Presupuestos...</em></p>
}
else if (listaPresupuestos.Count == 0)
{
    <p>No hay presupuestos disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Proyecto</th>
                <th>Monto Solicitado</th>
                <th>Monto Aprobado</th>
                <th>Estado</th>
                <th>Periodo</th>
                <th>Fecha Solicitud</th>
                <th>Fecha Aprobación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in listaPresupuestos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@listaProyectos.FirstOrDefault(x => x.Id == p.IdProyecto)?.Titulo</td>
                    <td>@p.MontoSolicitado</td>
                    <td>@p.MontoAprobado</td>
                    <td>@p.Estado</td>
                    <td>@p.PeriodoAnio</td>
                    <td>@p.FechaSolicitud.ToShortDateString()</td>
                    <td>@p.FechaAprobacion.ToShortDateString()</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                @onclick="@(() => CargarEnFormulario(p))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
 
@code {
    private List<Presupuesto> listaPresupuestos = new();
    private List<Proyecto> listaProyectos = new();
    private Presupuesto PresupuestoActual {get; set; } = new();
    private bool existePresupuesto = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;
 
    private const string urlPresupuesto = "api/Presupuesto";
    private const string urlProyecto = "api/Proyecto";
 
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarProyectos(), CargarPresupuestos());
    }
 
    private async Task CargarProyectos()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto>>>(urlProyecto);
            listaProyectos = respuesta?.Datos ?? new();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar proyectos: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task CargarPresupuestos()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Presupuesto>>>(urlPresupuesto);
            listaPresupuestos = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaPresupuestos.Count} presupuestos.";
            claseAviso = "alert alert-success";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al listar presupuestos: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
        finally { cargando = false; }
    }
 
    private async Task BuscarPorId()
    {
        LimpiarMensajes();
 
        if (PresupuestoActual.Id <= 0)
        {
            mensaje = "Debe ingresar un Id válido.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var ruta = $"{urlPresupuesto}/Id/{PresupuestoActual.Id}";
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Presupuesto>>>(ruta);
            var encontrado = respuesta?.Datos?.FirstOrDefault();
 
            if (encontrado is not null)
            {
                PresupuestoActual = new Presupuesto
                {
                    Id = encontrado.Id,
                    IdProyecto = encontrado.IdProyecto,
                    MontoSolicitado = encontrado.MontoSolicitado,
                    PeriodoAnio = encontrado.PeriodoAnio,
                    FechaSolicitud = encontrado.FechaSolicitud,
                    FechaAprobacion = encontrado.FechaAprobacion,
                    Observaciones = encontrado.Observaciones
                };
 
                existePresupuesto = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Presupuesto encontrado.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "No se encontró el presupuesto.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task GuardarSegunEstado()
    {
        if (existePresupuesto)
            await ActualizarPresupuesto();
        else
            await CrearPresupuesto();
    }
 
    private async Task CrearPresupuesto()
    {
        LimpiarMensajes();
 
        if (!ValidarFechas())
        {
            return;
        }
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var respuesta = await cliente.PostAsJsonAsync(urlPresupuesto, PresupuestoActual);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Presupuesto creado correctamente.";
                claseAviso = "alert alert-success";
                await CargarPresupuestos();
                LimpiarFormulario();
            }
            else
            {
                mensaje = "Error al crear el presupuesto.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ActualizarPresupuesto()
    {
        LimpiarMensajes();
 
        if (!ValidarFechas())
        {
            return;
        }
       
        if (PresupuestoActual.Id <= 0)
        {
            mensaje = "Debe indicar un **Id válido** para actualizar";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var ruta = $"{urlPresupuesto}/Id/{PresupuestoActual.Id}";
            var datos = new Dictionary<string, object?>
            {
                { "IdProyecto", PresupuestoActual.IdProyecto },
                { "MontoSolicitado", PresupuestoActual. MontoSolicitado},
                { "Estado", PresupuestoActual.Estado },
                {"PeriodoAnio", PresupuestoActual.PeriodoAnio},
                {"FechaSolicitud", PresupuestoActual.FechaSolicitud},
                {"FechaAprobacion", PresupuestoActual.FechaAprobacion},
                {"Observaciones", PresupuestoActual.Observaciones}
 
            };
 
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);
 
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Presupuesto actualizado correctamente.";
                claseAviso = "alert alert-success";
                await CargarPresupuestos();
                existePresupuesto = true;
            }
            else
            {
                mensaje = "Error al actualizar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task EliminarPresupuesto()
    {
        LimpiarMensajes();
 
        if (PresupuestoActual.Id <= 0)
        {
            mensaje = "Debe indicar un Id válido.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var ruta = $"{urlPresupuesto}/Id/{PresupuestoActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Presupuesto eliminado correctamente.";
                claseAviso = "alert alert-success";
                await CargarPresupuestos();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = "Error al eliminar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private void CargarEnFormulario(Presupuesto p)
    {
        PresupuestoActual = new Presupuesto
        {
            Id = p.Id,
            IdProyecto = p.IdProyecto,
            MontoSolicitado = p.MontoSolicitado,
            PeriodoAnio = p.PeriodoAnio,
            FechaSolicitud = p.FechaSolicitud,
            FechaAprobacion = p.FechaAprobacion,
            Observaciones = p.Observaciones
        };
 
        existePresupuesto = true;
        mensaje = "Presupuesto cargado en el formulario.";
        claseAviso = "alert alert-info";
    }
 
    private bool ValidarFechas()
    {
        LimpiarMensajes();
 
        if (PresupuestoActual.FechaAprobacion <= PresupuestoActual.FechaSolicitud)
        {
            mensaje = "La fecha Aprobación debe ser posterior a la Fecha Solicitud del proyecto.";
            claseAviso = "alert alert-info";
            return false;
        }
 
        return true;
    }
 
        private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarFormulario()
    {
        PresupuestoActual = new Presupuesto();
        existePresupuesto = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
 
    }
 
    private async Task ProbarConexion()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var respuesta = await cliente.GetAsync(urlPresupuesto);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
 
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
}