@page "/Archivo_Entregables"
 
@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer
 
<PageTitle>Archivo_Entregable</PageTitle>
 
<h3>Gestión de Archivo_Entregable</h3>
 
<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarArchivo_Entregable">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>
 
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}
 
<hr />
 
<h4>Formulario de Archivo_Entregable</h4>
 
<EditForm Model="Archivo_EntregableActual" OnValidSubmit="GuardarSegunExistencia">
    <DataAnnotationsValidator />
    <ValidationSummary />
 
    <div class="row g-3 mb-3" style="max-width: 800px;">
        <div class="col-md-6">
            <label class="form-label mb-0">Archivo</label>
            <InputSelect class="form-select" @bind-Value="Archivo_EntregableActual.IdArchivo" TValue="int">
                <option value="0">-- Seleccione Archivo --</option>
                @foreach (var a in listaArchivo)
                {
                    <option value="@a.Id">@a.Nombre (ID: @a.Id)</option>
                }
            </InputSelect>
        </div>
 
        <div class="col-md-6">
            <label class="form-label mb-0">Entregable</label>
            <InputSelect class="form-select" @bind-Value="Archivo_EntregableActual.IdEntregable" TValue="int">
                <option value="0">-- Seleccione Entregable --</option>
                @foreach (var e in listaEntregable)
                {
                    <option value="@e.Id">@e.Titulo (ID: @e.Id)</option>
                }
            </InputSelect>
        </div>
    </div>
 
    <div class="mt-3 d-flex flex-wrap align-items-center gap-3">
        <label class="fw-bold m-0 text-muted">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <div class="vr"></div>
        <button type="button" class="btn btn-outline-secondary" @onclick="BuscarPorCodigo">Buscar (por IdArchivo)</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarArchivo_Entregable" disabled="@(!existeArchivo_Entregable)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarArchivo_Entregable" disabled="@(!existeArchivo_Entregable)">Eliminar</button>
    </div>
</EditForm>
 
<hr />
 
@if (cargando)
{
    <p><em>Cargando Archivo_Entregable...</em></p>
}
else if (listaArchivo_Entregable.Count == 0)
{
    <p>No hay Archivo_Entregable disponibles.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id Archivo (Nombre)</th>
                <th>Id Entregable (Título)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in listaArchivo_Entregable)
            {
                <tr>
                    <td>@item.IdArchivo (@item.ArchivoNombre)</td>
                    <td>@item.IdEntregable (@item.EntregableTitulo)</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                @onclick="@(() => CargarEnFormulario(item))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
 
@code {
    private List<Archivo_Entregable> listaArchivo_Entregable = new();
    private List<Archivo> listaArchivo = new();
    private List<Entregable> listaEntregable = new();
 
    private Archivo_Entregable Archivo_EntregableActual { get; set; } = new();
 
    private bool existeArchivo_Entregable = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;
 
    private const string urlBaseApi = "api/Archivo_Entregable";
    private const string urlEntregable = "api/Entregable";
    private const string urlArchivo = "api/Archivo";
 
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarDatosIniciales(), CargarArchivo_Entregable());
    }
 
    private async Task CargarDatosIniciales()
    {
        await Task.WhenAll(CargarArchivo(), CargarEntregable());
    }
 
    private async Task CargarArchivo()
    {
        try
        {
            // Nota: Se asume que la fábrica tiene el cliente configurado como "ApiArchivo"
            var cliente = fabricaHttp.CreateClient("ApiArchivo");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Archivo>>>(urlArchivo);
            listaArchivo = respuesta?.Datos ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar Archivo: {ex.Message}");
        }
    }
 
    private async Task CargarEntregable()
    {
        try
        {
            // Nota: Se asume que la fábrica tiene el cliente configurado como "ApiEntregable"
            var cliente = fabricaHttp.CreateClient("ApiEntregable");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Entregable>>>(urlEntregable);
            listaEntregable = respuesta?.Datos ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar Entregable: {ex.Message}");
        }
    }
 
    // ⭐ MÉTODO CORREGIDO: Se añade lógica para poblar los nombres de las entidades relacionadas.
    private async Task CargarArchivo_Entregable()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiArchivo_Entregable");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Archivo_Entregable>>>(urlBaseApi);
            listaArchivo_Entregable = respuesta?.Datos ?? new();
 
            // Lógica de enriquecimiento de datos para mostrar nombres en la tabla
            foreach (var item in listaArchivo_Entregable)
            {
                // Busca el Archivo por IdArchivo (que se mapea a Id en el modelo Archivo)
                var archivo = listaArchivo.FirstOrDefault(a => a.Id == item.IdArchivo);
                if (archivo != null)
                {
                    item.ArchivoNombre = archivo.Nombre;
                }
 
                // Busca el Entregable por IdEntregable (que se mapea a Id en el modelo Entregable)
                var entregable = listaEntregable.FirstOrDefault(e => e.Id == item.IdEntregable);
                if (entregable != null)
                {
                    item.EntregableTitulo = entregable.Titulo;
                }
            }
 
            mensaje = $"Se cargaron {listaArchivo_Entregable.Count} Archivo_Entregable(s).";
            claseAviso = "alert alert-success";
        }
        catch (Exception error)
        {
            mensaje = $"Error al listar Archivo_Entregable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }
 
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();
 
        // Para las tablas de relación N:N, buscar por un solo ID (IdArchivo) no es un identificador único.
        // Se ajusta la lógica para buscar por la combinación de ambos IDs si es posible, o se utiliza
        // simplemente la función CargarEnFormulario desde la tabla para facilitar la edición.
        if (Archivo_EntregableActual.IdArchivo <= 0)
        {
            mensaje = "Debe indicar un Id de Archivo válido (mayor a 0) para buscar. Para una búsqueda más precisa, use el listado.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            // Se asume que la API permite la búsqueda de una relación N:N por uno de los IDs.
            var cliente = fabricaHttp.CreateClient("ApiArchivo_Entregable");
            var ruta = $"{urlBaseApi}/IdArchivo/{Archivo_EntregableActual.IdArchivo}";
           
            // Nota: El endpoint original devuelve una lista, lo cual es correcto ya que un archivo puede estar en múltiples entregables.
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Archivo_Entregable>>>(ruta);
            var encontrado = respuesta?.Datos?.FirstOrDefault();
 
            if (encontrado is not null)
            {
                // Se pobla la información de visualización al cargar en el formulario
                CargarEnFormulario(encontrado);
                mensaje = $"Archivo_Entregable para Archivo ID {encontrado.IdArchivo} cargado.";
            }
            else
            {
                existeArchivo_Entregable = false;
                textoBotonGuardar = "Crear";
                mensaje = $"No se encontró Archivo_Entregable para Archivo ID {Archivo_EntregableActual.IdArchivo}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            existeArchivo_Entregable = false;
            textoBotonGuardar = "Crear";
            mensaje = $"Error al buscar Archivo_Entregable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task GuardarSegunExistencia()
    {
        if (existeArchivo_Entregable)
            await ActualizarArchivo_Entregable();
        else
            await CrearArchivo_Entregable();
    }
 
    private async Task CrearArchivo_Entregable()
    {
        LimpiarMensajes();
 
        try
        {
            if (Archivo_EntregableActual.IdArchivo <= 0 || Archivo_EntregableActual.IdEntregable <= 0)
            {
                mensaje = "Debe seleccionar un Archivo y un Entregable válidos.";
                claseAviso = "alert alert-warning";
                return;
            }
 
            var cliente = fabricaHttp.CreateClient("ApiArchivo_Entregable");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, Archivo_EntregableActual);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Archivo_Entregable creado correctamente.";
                claseAviso = "alert alert-success";
                await CargarArchivo_Entregable();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el Archivo_Entregable. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al crear Archivo_Entregable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ActualizarArchivo_Entregable()
    {
        LimpiarMensajes();
 
        // Para actualizar una relación N:N, generalmente se utiliza la combinación de las dos claves.
        if (Archivo_EntregableActual.IdArchivo <= 0 || Archivo_EntregableActual.IdEntregable <= 0)
        {
            mensaje = "Debe cargar un Archivo_Entregable válido para actualizar (ambos IDs).";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo_Entregable");
            // Se asume que el endpoint de PUT usa ambos IDs para identificar el registro único,
            // aunque el código original solo usa IdArchivo. Se mantiene la estructura original del código del usuario
            // pero se advierte que lo ideal sería usar un ID compuesto o que la API maneje la actualización.
            var ruta = $"{urlBaseApi}/IdArchivo/{Archivo_EntregableActual.IdArchivo}";
            var respuesta = await cliente.PutAsJsonAsync(ruta, Archivo_EntregableActual);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Archivo_Entregable actualizado correctamente.";
                claseAviso = "alert alert-success";
                await CargarArchivo_Entregable();
                existeArchivo_Entregable = true;
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo actualizar el Archivo_Entregable. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al actualizar el Archivo_Entregable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task EliminarArchivo_Entregable()
    {
        LimpiarMensajes();
 
        // Para eliminar una relación N:N, se necesita la combinación de los dos IDs.
        if (Archivo_EntregableActual.IdArchivo <= 0 || Archivo_EntregableActual.IdEntregable <= 0)
        {
            mensaje = "Debe cargar el Archivo_Entregable (ambos IDs) para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo_Entregable");
            // Se asume que la API acepta la eliminación mediante las claves compuestas,
            // aunque el código original solo usa IdArchivo. Se mantiene la estructura original.
            var ruta = $"{urlBaseApi}/IdArchivo/{Archivo_EntregableActual.IdArchivo}";
            var respuesta = await cliente.DeleteAsync(ruta);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Archivo_Entregable eliminado correctamente.";
                claseAviso = "alert alert-success";
                await CargarArchivo_Entregable();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo eliminar el Archivo_Entregable. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al eliminar el Archivo_Entregable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ProbarConexion()
    {
        LimpiarMensajes();
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiArchivo_Entregable");
            var respuesta = await cliente.GetAsync(urlBaseApi);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error de conexión a la API: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    // ⭐ MÉTODO CORREGIDO: Se añade lógica para poblar los nombres al cargar desde el formulario/tabla.
    private void CargarEnFormulario(Archivo_Entregable s)
    {
        // Se crea una nueva instancia para evitar modificar directamente el objeto de la lista
        Archivo_EntregableActual = new Archivo_Entregable
        {
            IdArchivo = s.IdArchivo,
            IdEntregable = s.IdEntregable,
            // Se copian los nombres de visualización para referencia en el formulario (aunque no se muestren allí directamente)
            ArchivoNombre = s.ArchivoNombre,
            EntregableTitulo = s.EntregableTitulo
        };
 
        existeArchivo_Entregable = true;
        textoBotonGuardar = "Actualizar";
        mensaje = $"Archivo_Entregable seleccionado: Archivo ID {s.IdArchivo} y Entregable ID {s.IdEntregable}.";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarFormulario()
    {
        Archivo_EntregableActual = new Archivo_Entregable();
        existeArchivo_Entregable = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}