@page "/Proyecto_Productos"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer

<PageTitle>Gestión de Proyecto_Producto</PageTitle>

<h3 class="mb-4 text-primary fw-bold">Gestión de Proyecto_Producto</h3>

<div class="mb-3 d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarProyecto_Producto">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}

<hr />

<h4 class="text-secondary">Formulario de Asociación Proyecto - Producto</h4>

<EditForm Model="Proyecto_ProductoActual" OnValidSubmit="GuardarSegunProyecto_Producto">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="d-flex flex-column gap-3 mb-3" style="max-width: 500px;">
        <div>
            <label class="form-label mb-0">Proyecto</label>
            <InputSelect class="form-select" @bind-Value="Proyecto_ProductoActual.IdProyecto" TValue="int">
                <option value="0">-- Seleccione Proyecto --</option>
                @foreach (var p in listaProyecto)
                {
                    <option value="@p.Id">@p.Titulo (ID: @p.Id)</option>
                }
            </InputSelect>
        </div>

        <div>
            <label class="form-label mb-0">Producto</label>
            <InputSelect class="form-select" @bind-Value="Proyecto_ProductoActual.IdProducto" TValue="int">
                <option value="0">-- Seleccione Producto --</option>
                @foreach (var o in listaProducto)
                {
                    @* CORRECCIÓN PRINCIPAL: Se usa @o.Titulo, asumiendo que es la propiedad descriptiva del modelo Producto *@
                    <option value="@o.Id">@o.Titulo (ID: @o.Id)</option>
                }
            </InputSelect>
        </div>

        <div>
            <label class="form-label mb-0">Fecha de Asociación</label>
            <InputDate class="form-control" @bind-Value="Proyecto_ProductoActual.FechaAsociacion" />
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
        <label class="fw-bold m-0">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarProyecto_Producto" disabled="@(!existeProyecto_Producto)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <p><em>Cargando asociaciones...</em></p>
}
else if (listaProyecto_Producto.Count == 0)
{
    <p>No hay asociaciones disponibles.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Proyecto</th>
                <th>Producto</th>
                <th>Fecha Asociación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pp in listaProyecto_Producto)
            {
                <tr>
                    <td>@pp.IdProyecto (@pp.ProyectoTitulo)</td>
                    <td>@pp.IdProducto (@pp.ProductoTitulo)</td>
                    <td>@pp.FechaAsociacion?.ToShortDateString()</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="(() => CargarEnFormulario(pp))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // El bloque @code se mantiene sin cambios ya que los errores CS1061 y CS1662
    // se resuelven con la corrección del @o.Nombre por @o.Titulo en el bloque Razor.
    
    // ========================= VARIABLES =========================
    private List<Proyecto_Producto> listaProyecto_Producto = new();
    private List<Proyecto> listaProyecto = new();
    private List<Producto> listaProducto = new();

    private Proyecto_Producto Proyecto_ProductoActual { get; set; } = new();

    private bool existeProyecto_Producto = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlBaseApi = "api/Proyecto_Producto";
    private const string urlProyecto = "api/Proyecto";
    private const string urlProducto = "api/Producto";

    // ========================= CICLO DE VIDA =========================
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarProyecto(), CargarProducto(), CargarProyecto_Producto());
    }

    // ========================= CARGAS INICIALES =========================
    private async Task CargarProyecto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto>>>(urlProyecto);
            
            listaProyecto = respuesta?.Datos ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar proyectos: {ex.Message}");
        }
    }

    private async Task CargarProducto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProducto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Producto>>>(urlProducto);
            listaProducto = respuesta?.Datos ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
    }

    // ========================= CRUD =========================
    private async Task CargarProyecto_Producto()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiProyecto_Producto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto_Producto>>>(urlBaseApi);
            listaProyecto_Producto = respuesta?.Datos ?? [];
            mensaje = $"Se cargaron {listaProyecto_Producto.Count} asociaciones.";
            claseAviso = "alert alert-success";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al listar asociaciones: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();

        if (Proyecto_ProductoActual.IdProyecto <= 0 || Proyecto_ProductoActual.IdProducto <= 0)
        {
            mensaje = "Debe indicar IdProyecto e IdProducto válidos.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProyecto_Producto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto_Producto>>>(urlBaseApi);
            var encontrado = respuesta?.Datos?
                .FirstOrDefault(x => x.IdProyecto == Proyecto_ProductoActual.IdProyecto &&
                                     x.IdProducto == Proyecto_ProductoActual.IdProducto);

            if (encontrado is not null)
            {
                Proyecto_ProductoActual = encontrado;
                existeProyecto_Producto = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Asociación encontrada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "Asociación no encontrada.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunProyecto_Producto()
    {
        if (existeProyecto_Producto)
            await ActualizarProyecto_Producto();
        else
            await CrearProyecto_Producto();
    }

    private async Task CrearProyecto_Producto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProyecto_Producto");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, Proyecto_ProductoActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarProyecto_Producto();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al crear: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al crear: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarProyecto_Producto()
{
    try
    {
        var cliente = fabricaHttp.CreateClient("ApiProyecto_Producto");
 
        var ruta = $"{urlBaseApi}/IdProyecto/{Proyecto_ProductoActual.IdProyecto}";

        var datos = new Dictionary<string, object?>
            {
                { "FechaAsociacion", Proyecto_ProductoActual.FechaAsociacion }
                
            };

        // Se envía el objeto completo como JSON
        var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

        if (respuesta.IsSuccessStatusCode)
        {
            mensaje = "Asociación actualizada correctamente.";
            claseAviso = "alert alert-success";
            await CargarProyecto_Producto();
        }
        else
        {
            var detalle = await respuesta.Content.ReadAsStringAsync();
            mensaje = $"Error al actualizar: {detalle}";
            claseAviso = "alert alert-danger";
        }
    }
    catch (Exception ex)
    {
        mensaje = $"Error al actualizar: {ex.Message}";
        claseAviso = "alert alert-danger";
    }
}


private async Task EliminarProyecto_Producto()
{
    try
    {
        var cliente = fabricaHttp.CreateClient("ApiProyecto_Producto");

        var ruta = $"{urlBaseApi}/IdProyecto/{Proyecto_ProductoActual.IdProyecto}";
        var respuesta = await cliente.DeleteAsync(ruta);

        if (respuesta.IsSuccessStatusCode)
        {
            mensaje = "Asociación eliminada correctamente.";
            claseAviso = "alert alert-success";
            await CargarProyecto_Producto();
            LimpiarFormulario();
        }
        else
        {
            var detalle = await respuesta.Content.ReadAsStringAsync();
            mensaje = $"Error al eliminar: {detalle}";
            claseAviso = "alert alert-danger";
        }
    }
    catch (Exception ex)
    {
        mensaje = $"Error al eliminar: {ex.Message}";
        claseAviso = "alert alert-danger";
    }
}


    // ========================= AUXILIARES =========================
    private async Task ProbarConexion()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProyecto_Producto");
            var respuesta = await cliente.GetAsync(urlBaseApi);

            if (respuesta.IsSuccessStatusCode)
                mensaje = "Conexión con la API verificada.";
            else
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";

            claseAviso = "alert alert-info";
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(Proyecto_Producto pp)
    {
        Proyecto_ProductoActual = new Proyecto_Producto
        {
            IdProyecto = pp.IdProyecto,
            IdProducto = pp.IdProducto,
            FechaAsociacion = pp.FechaAsociacion
        };

        existeProyecto_Producto = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Asociación cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        Proyecto_ProductoActual = new Proyecto_Producto();
        existeProyecto_Producto = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}