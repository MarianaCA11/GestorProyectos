@page "/Meta_Proyectos"
 
@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer
 
<PageTitle>Gestión de Meta_Proyecto</PageTitle>
 
<h3 class="mb-4 text-primary fw-bold">Gestión de Meta_Proyecto</h3>
 
<div class="mb-3 d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarMeta_Proyecto">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>
 
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}
 
<hr />
 
<h4 class="text-secondary">Formulario de Asociación Meta Estratégica - Proyecto</h4>
 
<EditForm Model="Meta_ProyectoActual" OnValidSubmit="GuardarSegunMeta_Proyecto">
    <DataAnnotationsValidator />
    <ValidationSummary />
 
    <div class="d-flex flex-column gap-3 mb-3" style="max-width: 500px;">
        <div>
            <label class="form-label mb-0">Meta Estratégica</label>
            <InputSelect class="form-select" @bind-Value="Meta_ProyectoActual.IdMeta" TValue="int">
                <option value="0">-- Seleccione Meta --</option>
                @foreach (var m in listaMeta)
                {
                    <option value="@m.Id">@m.Titulo (ID: @m.Id)</option>
                }
            </InputSelect>
        </div>
 
        <div>
            <label class="form-label mb-0">Proyecto</label>
            <InputSelect class="form-select" @bind-Value="Meta_ProyectoActual.IdProyecto" TValue="int">
                <option value="0">-- Seleccione Proyecto --</option>
                @foreach (var p in listaProyecto)
                {
                    <option value="@p.Id">@p.Titulo (ID: @p.Id)</option>
                }
            </InputSelect>
        </div>
 
        <div>
            <label class="form-label mb-0">Fecha de Asociación</label>
            <InputDate class="form-control" @bind-Value="Meta_ProyectoActual.FechaAsociacion" />
        </div>
    </div>
 
    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
        <label class="fw-bold m-0">Acciones CRUD:</label>
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorCodigo">Buscar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarMeta_Proyecto" disabled="@(!existeMeta_Proyecto)">Eliminar</button>
    </div>
</EditForm>
 
<hr />
 
@if (cargando)
{
    <p><em>Cargando asociaciones...</em></p>
}
else if (listaMeta_Proyecto.Count == 0)
{
    <p>No hay asociaciones disponibles.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Meta Estratégica</th>
                <th>Proyecto</th>
                <th>Fecha Asociación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mp in listaMeta_Proyecto)
            {
                <tr>
                    <td>@mp.IdMeta (@mp.MetaTitulo)</td>
                    <td>@mp.IdProyecto (@mp.ProyectoTitulo)</td>
                    <td>@mp.FechaAsociacion?.ToShortDateString()</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="(() => CargarEnFormulario(mp))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
 
@code {
    // ========================= VARIABLES =========================
    private List<Meta_Proyecto> listaMeta_Proyecto = new();
    private List<MetaEstrategica> listaMeta = new();
    private List<Proyecto> listaProyecto = new();
 
    private Meta_Proyecto Meta_ProyectoActual { get; set; } = new();
 
    private bool existeMeta_Proyecto = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;
 
    private const string urlBaseApi = "api/Meta_Proyecto";
    private const string urlMeta = "api/MetaEstrategica";
    private const string urlProyecto = "api/Proyecto";
 
    // ========================= CICLO DE VIDA =========================
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarMeta(), CargarProyecto(), CargarMeta_Proyecto());
    }
 
    // ========================= CARGAS INICIALES =========================
    private async Task CargarMeta()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<MetaEstrategica>>>(urlMeta);
            listaMeta = respuesta?.Datos ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar metas: {ex.Message}");
        }
    }
 
    private async Task CargarProyecto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto>>>(urlProyecto);
            listaProyecto = respuesta?.Datos ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar proyectos: {ex.Message}");
        }
    }
 
    // ========================= CRUD =========================
    private async Task CargarMeta_Proyecto()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Meta_Proyecto>>>(urlBaseApi);
            listaMeta_Proyecto = respuesta?.Datos ?? [];
            mensaje = $"Se cargaron {listaMeta_Proyecto.Count} asociaciones.";
            claseAviso = "alert alert-success";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al listar asociaciones: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }
 
    private async Task BuscarPorCodigo()
    {
        LimpiarMensajes();
 
        if (Meta_ProyectoActual.IdMeta <= 0 || Meta_ProyectoActual.IdProyecto <= 0)
        {
            mensaje = "Debe indicar IdMeta e IdProyecto válidos.";
            claseAviso = "alert alert-warning";
            return;
        }
 
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Meta_Proyecto>>>(urlBaseApi);
            var encontrado = respuesta?.Datos?
                .FirstOrDefault(x => x.IdMeta == Meta_ProyectoActual.IdMeta &&
                                     x.IdProyecto == Meta_ProyectoActual.IdProyecto);
 
            if (encontrado is not null)
            {
                Meta_ProyectoActual = encontrado;
                existeMeta_Proyecto = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Asociación encontrada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "Asociación no encontrada.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task GuardarSegunMeta_Proyecto()
    {
        if (existeMeta_Proyecto)
            await ActualizarMeta_Proyecto();
        else
            await CrearMeta_Proyecto();
    }
 
    private async Task CrearMeta_Proyecto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var respuesta = await cliente.PostAsJsonAsync(urlBaseApi, Meta_ProyectoActual);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarMeta_Proyecto();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al crear: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al crear: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task ActualizarMeta_Proyecto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var ruta = $"{urlBaseApi}/IdMeta/{Meta_ProyectoActual.IdMeta}";
 
            var datos = new Dictionary<string, object?>
            {
                { "FechaAsociacion", Meta_ProyectoActual.FechaAsociacion }
            };
 
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación actualizada correctamente.";
                claseAviso = "alert alert-success";
                await CargarMeta_Proyecto();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al actualizar: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al actualizar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private async Task EliminarMeta_Proyecto()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var ruta = $"{urlBaseApi}/IdMeta/{Meta_ProyectoActual.IdMeta}";
            var respuesta = await cliente.DeleteAsync(ruta);
 
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Asociación eliminada correctamente.";
                claseAviso = "alert alert-success";
                await CargarMeta_Proyecto();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"Error al eliminar: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al eliminar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    // ========================= AUXILIARES =========================
    private async Task ProbarConexion()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiMeta_Proyecto");
            var respuesta = await cliente.GetAsync(urlBaseApi);
 
            if (respuesta.IsSuccessStatusCode)
                mensaje = "Conexión con la API verificada.";
            else
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
 
            claseAviso = "alert alert-info";
        }
        catch (Exception ex)
        {
            mensaje = $"Error de conexión: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }
 
    private void CargarEnFormulario(Meta_Proyecto mp)
    {
        Meta_ProyectoActual = new Meta_Proyecto
        {
            IdMeta = mp.IdMeta,
            IdProyecto = mp.IdProyecto,
            FechaAsociacion = mp.FechaAsociacion
        };
 
        existeMeta_Proyecto = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Asociación cargada en el formulario.";
        claseAviso = "alert alert-info";
    }
 
    private void LimpiarFormulario()
    {
        Meta_ProyectoActual = new Meta_Proyecto();
        existeMeta_Proyecto = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
 
    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}