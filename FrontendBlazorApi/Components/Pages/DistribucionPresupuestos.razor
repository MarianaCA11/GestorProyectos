@page "/distribucionpresupuestos"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@inject IHttpClientFactory fabricaHttp
@rendermode InteractiveServer

<PageTitle>Distribución de Presupuesto</PageTitle>

<h3>Gestión de Distribución de Presupuesto</h3>

<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarDistribuciones">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso">@mensaje</div>
}

<hr />
<h4>Formulario de Distribución</h4>

<EditForm Model="DistribucionActual" OnValidSubmit="GuardarSegunEstado">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="d-flex flex-column gap-3 mb-3" style="max-width:600px;">
        <div class="d-flex gap-2">
            <div style="width:120px;">
                <label class="form-label mb-0">Id</label>
                <InputNumber class="form-control" @bind-Value="DistribucionActual.Id" />
            </div>

            <div class="flex-grow-1">
                <label class="form-label mb-0">Presupuesto Padre</label>
                <InputSelect class="form-select" @bind-Value="DistribucionActual.IdPresupuestoPadre">
                    <option value="0">-- Seleccione Presupuesto --</option>
                    @foreach (var p in listaPresupuestos)
                    {
                        <option value="@p.Id">@p.MontoAprobado </option>
                    }
                </InputSelect>
            </div>
        </div>

        <div>
            <label class="form-label mb-0">Proyecto Hijo</label>
            <InputSelect class="form-select" @bind-Value="DistribucionActual.IdProyectoHijo">
                <option value="0">-- Seleccione Proyecto --</option>
                @foreach (var proyecto in listaProyectos)
                {
                    <option value="@proyecto.Id">@proyecto.Titulo</option>
                }
            </InputSelect>
        </div>

        <div>
            <label class="form-label mb-0">Monto Asignado</label>
            <InputNumber class="form-control" step="0.01" @bind-Value="DistribucionActual.MontoAsignado" />
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-secondary" @onclick="BuscarPorId">Buscar</button>
        <button type="button" class="btn btn-warning" @onclick="ActualizarDistribucion" disabled="@(!existeDistribucion)">Actualizar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarDistribucion" disabled="@(!existeDistribucion)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <p><em>Cargando distribuciones...</em></p>
}
else if (listaDistribuciones.Count == 0)
{
    <p>No hay distribuciones registradas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Presupuesto Padre</th>
                <th>Proyecto Hijo</th>
                <th>Monto Asignado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in listaDistribuciones)
            {
                <tr>
                    <td>@d.Id</td>
                    <td>@listaPresupuestos.FirstOrDefault(x => x.Id == d.IdPresupuestoPadre)?.MontoAprobado</td>
                    <td>@listaProyectos.FirstOrDefault(x => x.Id == d.IdProyectoHijo)?.Titulo</td>
                    <td>@d.MontoAsignado.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="@(() => CargarEnFormulario(d))">Cargar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DistribucionPresupuesto> listaDistribuciones = new();
    private List<Presupuesto> listaPresupuestos = new();
    private List<Proyecto> listaProyectos = new();

    
    [SupplyParameterFromForm]
    private DistribucionPresupuesto DistribucionActual {get; set; } = new();
    private bool existeDistribucion = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlDistribucion = "api/DistribucionPresupuesto";
    private const string urlPresupuesto = "api/Presupuesto";
    private const string urlProyecto = "api/Proyecto";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarPresupuestos(), CargarProyectos(), CargarDistribuciones());
    }

    private async Task CargarPresupuestos()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiPresupuesto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Presupuesto>>>(urlPresupuesto);
            listaPresupuestos = respuesta?.Datos ?? new List<Presupuesto>();;
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar presupuestos: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task CargarProyectos()
    {
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiProyecto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto>>>(urlProyecto);
            listaProyectos = respuesta?.Datos ?? new List<Proyecto>();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar proyectos: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task CargarDistribuciones()
    {
        try
        {
            cargando = true;
            var cliente = fabricaHttp.CreateClient("ApiDistribucionPresupuesto");
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<DistribucionPresupuesto>>>(urlDistribucion);
            listaDistribuciones = respuesta?.Datos ?? new List<DistribucionPresupuesto>();
            mensaje = $"Se cargaron {listaDistribuciones.Count} registros.";
            claseAviso = "alert alert-success";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al listar distribuciones: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
        finally { cargando = false; }
    }

    private async Task BuscarPorId()
    {
        LimpiarMensajes();

        if (DistribucionActual.Id <= 0)
        {
            mensaje = "Debe ingresar un Id válido.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiDistribucionPresupuesto");
            var ruta = $"{urlDistribucion}/Id/{DistribucionActual.Id}";
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<DistribucionPresupuesto>>>(ruta);
            var encontrado = respuesta?.Datos?.FirstOrDefault();

            if (encontrado is not null)
            {
                DistribucionActual = new DistribucionPresupuesto
                {
                    Id = encontrado.Id,
                    IdPresupuestoPadre = encontrado.IdPresupuestoPadre,
                    IdProyectoHijo = encontrado.IdProyectoHijo,
                    MontoAsignado = encontrado.MontoAsignado
                };

                existeDistribucion = true;
                textoBotonGuardar = "Actualizar";
                mensaje = "Distribución encontrada.";
                claseAviso = "alert alert-success";
            }
            else
            {   
                existeDistribucion = false;
                textoBotonGuardar = "Crear";
                mensaje = "No se encontró la distribución.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            existeDistribucion = false;
            textoBotonGuardar = "Crear";
            mensaje = $"Error al buscar: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunEstado()
    {
        if (existeDistribucion)
            await ActualizarDistribucion();
        else
            await CrearDistribucion();
    }

    private async Task CrearDistribucion()
    {
        LimpiarMensajes();
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiDistribucionPresupuesto");
            var respuesta = await cliente.PostAsJsonAsync(urlDistribucion, DistribucionActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Distribución creada correctamente.";
                claseAviso = "alert alert-success";
                await CargarDistribuciones();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = "Error al crear la distribución.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarDistribucion()
    {
        LimpiarMensajes();
        
        if (DistribucionActual.Id <= 0)
        {
            mensaje = "Debe indicar un **Id válido** para actualizar";
            claseAviso = "alert alert-warning";
            return;
        }
        try
        {
            var cliente = fabricaHttp.CreateClient("ApiDistribucionPresupuesto");
            var ruta = $"{urlDistribucion}/Id/{DistribucionActual.Id}";

            var datos = new Dictionary<string,object?>
            {
                {"IdPresupuestoPadre", DistribucionActual.IdPresupuestoPadre},
                {"IdProyectoHijo", DistribucionActual.IdProyectoHijo},
                {"MontoAsignado", DistribucionActual.MontoAsignado}

            };
            var respuesta = await cliente.PutAsJsonAsync(ruta, datos);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Distribución actualizada correctamente.";
                claseAviso = "alert alert-success";
                await CargarDistribuciones();
                existeDistribucion = true;
                textoBotonGuardar = "Actualizar";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = "Error al actualizar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarDistribucion()
    {
        LimpiarMensajes();

        if (DistribucionActual.Id <= 0)
        {
            mensaje = "Debe indicar un Id válido.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiDistribucionPresupuesto");
            var ruta = $"{urlDistribucion}/Id/{DistribucionActual.Id}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Distribución eliminada correctamente.";
                claseAviso = "alert alert-success";
                await CargarDistribuciones();
                LimpiarFormulario();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = "Error al eliminar.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

        private async Task ProbarConexion()
    {
        LimpiarMensajes();

        try
        {
            var cliente = fabricaHttp.CreateClient("ApiDistribucionPresupuesto");
            
            var respuesta = await cliente.GetAsync(urlDistribucion);
            
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Conexión con la API verificada.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = $"La API respondió con código {(int)respuesta.StatusCode}.";
                claseAviso = "alert alert-warning";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error de conexión a la API: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }



    private void CargarEnFormulario(DistribucionPresupuesto d)
    {
        
        DistribucionActual = new DistribucionPresupuesto
        {
            Id = d.Id,
            IdPresupuestoPadre = d.IdPresupuestoPadre,
            IdProyectoHijo = d.IdProyectoHijo,
            MontoAsignado = d.MontoAsignado
        };
        
        existeDistribucion = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Distribución cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        DistribucionActual = new DistribucionPresupuesto();
        existeDistribucion = false;
        textoBotonGuardar = "Crear";
        LimpiarMensajes();
    }
}
